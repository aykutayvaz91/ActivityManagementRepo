@model ActivityManagement.Tasks.Dto.CreateUpdateTaskItemDto
@{
    ViewData["Title"] = "Yeni Görev";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employees = ViewBag.Employees as IList<ActivityManagement.Employees.Dto.EmployeeDto>;
    var projects = ViewBag.Projects as IList<ActivityManagement.Projects.Dto.ProjectDto>;
    var categories = ViewBag.Categories as System.Collections.Generic.List<ActivityManagement.Categories.Dto.CategoryDto>
                     ?? new System.Collections.Generic.List<ActivityManagement.Categories.Dto.CategoryDto>();
    bool isManager = User.IsInRole("Admin") || User.IsInRole("TakımLideri");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Tasks">Görevler</a></li>
            <li class="breadcrumb-item active">Yeni Görev</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Yeni Görev Oluştur</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @{ bool fromProject = ViewBag.FromProject == true; }
                    @if (fromProject)
                    {
                        <div class="alert alert-info py-2 small mb-2"><i class="fas fa-lock me-1"></i><strong>@ViewBag.ProjectName</strong> projesi görevi — kategori ve sorumlular projeden gelir (kilitli).</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ana Kategori</label>
                            <select id="categorySelect" class="form-select" disabled="@(fromProject ? "disabled" : null)">
                                <option value="">— Seçiniz —</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            @if (!isManager && !categories.Any())
                            {
                                <small class="text-muted">Sorumlusu olduğunuz bir ana kategori bulunmuyor.</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SubCategoryId" class="form-label">Alt Kategori</label>
                            @if (fromProject)
                            {
                                <input asp-for="SubCategoryId" type="hidden" />
                            }
                            <select asp-for="SubCategoryId" id="subCategorySelect" class="form-select" disabled="@(fromProject ? "disabled" : null)">
                                <option value="">— Önce ana kategori seçiniz —</option>
                            </select>
                            @if (!isManager)
                            {
                                <small class="text-muted" id="autoAssignNote" style="display:none">
                                    <i class="fas fa-info-circle me-1"></i>Bu görev otomatik olarak size atanacaktır.
                                </small>
                            }
                        </div>

                        <div class="col-md-6" id="activityTypeRow">
                            <label asp-for="ActivityType" class="form-label">Aktivite Tipi</label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="">Seçiniz...</option>
                                <option value="0">Bakım</option>
                                <option value="1">Geliştirme</option>
                                <option value="2">Kurulum</option>
                                <option value="3">Destek</option>
                                <option value="4">Test</option>
                                <option value="5">Dokümantasyon</option>
                                <option value="6">Eğitim</option>
                                <option value="7">Analiz</option>
                                <option value="8">Proje</option>
                                <option value="9">Diğer</option>
                            </select>
                        </div>

                        <div class="col-md-6" id="groupNameRow">
                            <label asp-for="GroupName" class="form-label">Görev Grubu</label>
                            <select asp-for="GroupName" class="form-select">
                                <option value="">Seçiniz...</option>
                                <option value="Sistem Birimi">Sistem Birimi</option>
                                <option value="Network Birimi">Network Birimi</option>
                                <option value="Ortak">Ortak (Sistem & Network)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Görev Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        @if (isManager)
                        {
                            <div class="col-md-6">
                                <label asp-for="ProjectId" class="form-label">Proje</label>
                                <select asp-for="ProjectId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (projects != null)
                                    {
                                        foreach (var p in projects)
                                        {
                                            <option value="@p.Id">[@p.Code] @p.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssignedEmployeeId" class="form-label">
                                    <i class="fas fa-user-tie text-primary me-1"></i>Ana Sorumlu
                                </label>
                                <select asp-for="AssignedEmployeeId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (employees != null)
                                    {
                                        foreach (var e in employees)
                                        {
                                            <option value="@e.Id">@e.FullName - @e.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SecondaryEmployeeId" class="form-label">
                                    <i class="fas fa-user text-secondary me-1"></i>2. Sorumlu <small class="text-muted">(yedek)</small>
                                </label>
                                <select asp-for="SecondaryEmployeeId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (employees != null)
                                    {
                                        foreach (var e in employees)
                                        {
                                            <option value="@e.Id">@e.FullName - @e.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AssignedByEmployeeId" class="form-label">Atayan Kişi</label>
                                <select asp-for="AssignedByEmployeeId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (employees != null)
                                    {
                                        foreach (var e in employees)
                                        {
                                            <option value="@e.Id">@e.FullName</option>
                                        }
                                    }
                                </select>
                            </div>
                        }

                        <div class="col-md-3">
                            <label asp-for="PriorityScore" class="form-label">Önem Derecesi <small class="text-muted">(1–10)</small></label>
                            <select asp-for="PriorityScore" class="form-select">
                                @for (int i = 10; i >= 1; i--)
                                {
                                    <option value="@i">@i @(i == 10 ? "(En Yüksek)" : i == 1 ? "(En Düşük)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label">Durum</label>
                            <select asp-for="Status" class="form-select">
                                <option value="0">Beklemede</option>
                                <option value="1">Devam Ediyor</option>
                                <option value="2">Tamamlandı</option>
                                <option value="3">İptal</option>
                                <option value="4">Ertelendi</option>
                            </select>
                        </div>
                        @{
                            var _sd = Model.StartDate ?? DateTime.Today;
                            var _sdDate = _sd.ToString("yyyy-MM-dd");
                            var _sdTime = (Model.StartDate.HasValue && (Model.StartDate.Value.Hour != 0 || Model.StartDate.Value.Minute != 0))
                                          ? Model.StartDate.Value.ToString("HH:mm") : "";
                        }
                        <div class="col-md-3">
                            <label class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                            <input type="date" name="startDatePart" value="@_sdDate" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Saat <small class="text-muted">(hh:mm)</small></label>
                            <input type="time" name="startTimePart" value="@_sdTime" class="form-control" />
                            <small class="text-muted">Boş = tüm gün</small>
                        </div>
                        @if (Model.ProjectId.HasValue)
                        {
                            <input asp-for="DueDate" type="hidden" />
                            <div class="col-md-4">
                                <label class="form-label">Son Tarih (SLA)</label>
                                <input class="form-control" value="Projenin SLA tarihinden alınır" disabled />
                                <small class="text-muted">Proje görevlerinde son tarih projeden miras alınır.</small>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label asp-for="DueDate" class="form-label">Son Tarih <span class="text-danger">*</span></label>
                                <input asp-for="DueDate" class="form-control" type="date" required />
                            </div>
                        }
                        <div class="col-md-4">
                            <label asp-for="EstimatedHours" class="form-label">Tahmini Süre (saat) <small class="text-muted">(opsiyonel)</small></label>
                            <input asp-for="EstimatedHours" class="form-control" type="number" step="0.5" min="0" />
                            <small class="text-muted">Zorunlu değil — takvimde tarih olması yeterli.</small>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="/Tasks" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function() {
        var categoriesData = @Html.Raw(ActivityManagement.Web.Utils.JsonHelper.ToCamelCaseJson(categories));
        var categorySelect = document.getElementById('categorySelect');
        var subCategorySelect = document.getElementById('subCategorySelect');
        var assignedSelect = document.getElementById('AssignedEmployeeId');
        var secondarySelect = document.getElementById('SecondaryEmployeeId');
        var autoAssignNote = document.getElementById('autoAssignNote');

        function findCategory(id) {
            for (var i = 0; i < categoriesData.length; i++) {
                if (String(categoriesData[i].id) === String(id)) return categoriesData[i];
            }
            return null;
        }

        function populateSubCategories() {
            var cat = findCategory(categorySelect.value);
            subCategorySelect.innerHTML = '';
            if (!cat) {
                subCategorySelect.appendChild(new Option('— Önce ana kategori seçiniz —', ''));
                return;
            }
            subCategorySelect.appendChild(new Option('Seçiniz...', ''));
            (cat.subCategories || []).forEach(function(sc) {
                subCategorySelect.appendChild(new Option(sc.name, sc.id));
            });
        }

        function applyResponsibleSuggestion() {
            var cat = findCategory(categorySelect.value);
            if (assignedSelect && secondarySelect) {
                if (cat) {
                    if (cat.responsibleEmployee1Id) assignedSelect.value = cat.responsibleEmployee1Id;
                    if (cat.responsibleEmployee2Id) secondarySelect.value = cat.responsibleEmployee2Id;
                }
            }
            if (autoAssignNote) {
                autoAssignNote.style.display = subCategorySelect.value ? '' : 'none';
            }
        }

        categorySelect.addEventListener('change', function() {
            populateSubCategories();
            applyResponsibleSuggestion();
        });
        subCategorySelect.addEventListener('change', applyResponsibleSuggestion);

        // Görevlerim'den gelen seçili kategori/alt kategoriyi otomatik seç
        (function preselect() {
            var preCat = '@(ViewBag.PreCategoryId?.ToString() ?? "")';
            var preSub = '@(Model.SubCategoryId?.ToString() ?? "")';
            function ownerCatOf(subId) {
                for (var i = 0; i < categoriesData.length; i++) {
                    var subs = categoriesData[i].subCategories || [];
                    for (var j = 0; j < subs.length; j++) if (String(subs[j].id) === String(subId)) return categoriesData[i].id;
                }
                return '';
            }
            if (!preCat && preSub) preCat = String(ownerCatOf(preSub) || '');
            if (preCat) {
                categorySelect.value = preCat;
                populateSubCategories();
                if (preSub) subCategorySelect.value = preSub;
                applyResponsibleSuggestion();
            }
        })();
    })();
    </script>
}

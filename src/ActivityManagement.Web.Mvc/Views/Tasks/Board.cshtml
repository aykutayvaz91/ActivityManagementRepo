@{
    ViewData["Title"] = "Pano";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-columns text-primary me-2"></i>Pano</h2>
    <div class="d-flex gap-2">
        <a href="/Tasks/Gantt" class="btn btn-outline-secondary"><i class="fas fa-stream me-1"></i>Gantt</a>
        @if (User?.IsInRole("Admin") == true)
        {
            <a href="/Tasks" class="btn btn-outline-secondary"><i class="fas fa-list me-1"></i>Liste</a>
        }
        @if (User?.IsInRole("Admin") == true || User?.IsInRole("TakımLideri") == true)
        {
            <a href="/Tasks/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Yeni Görev</a>
        }
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <div class="btn-group btn-group-sm" role="group">
        <input type="radio" class="btn-check" name="boardMode" id="mBoth" value="both" checked onchange="loadBoard()">
        <label class="btn btn-outline-primary" for="mBoth"><i class="fas fa-layer-group me-1"></i>İkisi</label>
        <input type="radio" class="btn-check" name="boardMode" id="mTasks" value="tasks" onchange="loadBoard()">
        <label class="btn btn-outline-primary" for="mTasks"><i class="fas fa-clipboard-list me-1"></i>Görevler</label>
        <input type="radio" class="btn-check" name="boardMode" id="mReq" value="requests" onchange="loadBoard()">
        <label class="btn btn-outline-primary" for="mReq"><i class="fas fa-inbox me-1"></i>Talepler</label>
    </div>
    <select id="projectFilter" class="form-select form-select-sm" style="max-width:280px" onchange="loadBoard()">
        <option value="">Tüm Projeler</option>
    </select>
    <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Ekip panosu. Yalnızca <strong>size ait</strong> kartları (<i class="fas fa-clipboard-list"></i> görev / <i class="fas fa-inbox"></i> talep) sürükleyerek durum güncellersiniz; diğerleri (<i class="fas fa-lock"></i>) salt görünüm.</small>
</div>

@Html.AntiForgeryToken()
<div id="board" class="d-flex gap-3 overflow-auto pb-3" style="min-height:60vh">
    <div class="text-center w-100 py-5"><div class="spinner-border text-primary"></div></div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
var statuses = [], tasks = [], requests = [];

// RequestStatus (0..6) → kolon (TaskStatus statusValue) eşlemesi
function reqToCol(rs) {
    switch (rs) {
        case 2: return 1;          // DevamEdiyor → DevamEdiyor
        case 4: case 5: return 2;  // Çözüldü/Kapandı → Tamamlandı
        case 6: return 3;          // İptal → İptal
        default: return 0;         // Yeni/Atandı/Beklemede → Beklemede
    }
}
// Kolon (TaskStatus statusValue) → yeni RequestStatus (sürükleyince)
function colToReq(cv) {
    switch (cv) {
        case 1: return 2;  // DevamEdiyor
        case 2: return 4;  // Tamamlandı → Çözüldü
        case 3: return 6;  // İptal
        default: return 3; // Beklemede/Ertelendi → Beklemede
    }
}
function mode() { return document.querySelector('input[name="boardMode"]:checked').value; }

$(document).ready(function () {
    $.get('/api/services/app/Project/GetAll', { maxResultCount: 200 }, function (r) {
        r.result.items.forEach(function (p) {
            $('#projectFilter').append('<option value="' + p.id + '">[' + p.code + '] ' + p.name + '</option>');
        });
    });
    loadBoard();
});

function loadBoard() {
    var m = mode();
    var calls = [$.get('/api/services/app/WorkflowStatus/GetAll', { onlyActive: true })];
    calls.push(m === 'requests' ? null : $.get('/api/services/app/TaskItem/GetAll', { projectId: $('#projectFilter').val() || null, maxResultCount: 1000 }));
    calls.push(m === 'tasks' ? null : $.get('/api/services/app/ServiceRequest/GetAll', { maxResultCount: 1000 }));
    $.when.apply($, calls.map(function (c) { return c || $.Deferred().resolve([{ result: { items: [] } }]).promise(); }))
     .done(function (s, t, r) {
        statuses = s[0].result;
        tasks = (t && t[0] && t[0].result) ? (t[0].result.items || []) : [];
        requests = (r && r[0] && r[0].result) ? (r[0].result.items || r[0].result || []) : [];
        renderBoard();
     });
}

function renderBoard() {
    var html = '';
    statuses.forEach(function (st) {
        var colTasks = tasks.filter(function (t) { return t.status === st.statusValue; });
        var colReqs = requests.filter(function (q) { return reqToCol(q.status) === st.statusValue; });
        html += '<div class="flex-shrink-0" style="width:300px">';
        html += '<div class="card shadow-sm h-100">';
        html += '<div class="card-header bg-' + (st.color || 'secondary') + ' text-white d-flex justify-content-between">';
        html += '<span>' + st.name + '</span><span class="badge bg-light text-dark">' + (colTasks.length + colReqs.length) + '</span></div>';
        html += '<div class="card-body p-2 board-col" data-status="' + st.statusValue + '" style="min-height:120px">';
        colTasks.forEach(function (t) { html += taskCard(t); });
        colReqs.forEach(function (q) { html += reqCard(q); });
        html += '</div></div></div>';
    });
    $('#board').html(html);

    document.querySelectorAll('.board-col').forEach(function (col) {
        new Sortable(col, {
            group: 'board',
            animation: 150,
            draggable: '.kanban-card',
            filter: '.not-editable',
            preventOnFilter: false,
            onMove: function (evt) { return !evt.dragged.classList.contains('not-editable'); },
            onAdd: function (evt) {
                var el = evt.item;
                var id = parseInt(el.getAttribute('data-id'));
                var colVal = parseInt(evt.to.getAttribute('data-status'));
                if (el.getAttribute('data-kind') === 'request') {
                    var q = requests.find(function (x) { return x.id === id; });
                    if (!q || !(q.canManage || q.canLogEffort)) { abp.notify.warn('Bu talep üzerinde yetkiniz yok.'); loadBoard(); return; }
                    changeRequestStatus(id, colToReq(colVal));
                } else {
                    var t = tasks.find(function (x) { return x.id === id; });
                    if (!t || !t.canEdit) { abp.notify.warn('Bu görev üzerinde yetkiniz yok.'); loadBoard(); return; }
                    changeTaskStatus(id, colVal);
                }
            }
        });
    });
}

function escHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function taskCard(t) {
    var pr = { 0: 'secondary', 1: 'info', 2: 'warning', 3: 'danger' };
    var overdue = t.dueDate && new Date(t.dueDate) < new Date() && t.status !== 2;
    var editable = !!t.canEdit;
    var h = '<div class="card mb-2 kanban-card ' + (editable ? '' : 'not-editable') + '" data-id="' + t.id + '" data-kind="task" '
          + 'style="' + (editable ? 'cursor:grab' : 'cursor:not-allowed;opacity:.5;filter:grayscale(60%)') + '">';
    h += '<div class="card-body p-2">';
    h += '<div class="small fw-semibold mb-1 d-flex align-items-center gap-1">';
    h += '<i class="fas fa-clipboard-list text-primary" style="font-size:.7rem" title="Görev"></i>';
    if (!editable) h += '<i class="fas fa-lock text-muted" style="font-size:.7rem"></i>';
    h += '<a href="/Tasks/Detail/' + t.id + '" class="text-decoration-none">' + escHtml(t.title) + '</a></div>';
    h += '<div class="d-flex justify-content-between align-items-center">';
    h += '<span class="badge bg-' + (pr[t.priority] || 'secondary') + '">' + escHtml(t.priorityText) + '</span>';
    if (t.assignedEmployeeName) h += '<small class="text-muted">' + escHtml(t.assignedEmployeeName) + '</small>';
    h += '</div>';
    var cat = t.categoryName ? (escHtml(t.categoryName) + (t.subCategoryName ? ' / ' + escHtml(t.subCategoryName) : '')) : '';
    if (cat) h += '<div class="small text-muted mt-1"><i class="fas fa-tag me-1"></i>' + cat + '</div>';
    if (t.dueDate) h += '<div class="small ' + (overdue ? 'text-danger' : 'text-muted') + '"><i class="far fa-calendar me-1"></i>' + new Date(t.dueDate).toLocaleDateString('tr-TR') + '</div>';
    h += '<div class="progress mt-1" style="height:4px"><div class="progress-bar" style="width:' + t.completionPercentage + '%"></div></div>';
    h += '</div></div>';
    return h;
}

function reqCard(q) {
    var editable = !!(q.canManage || q.canLogEffort);
    var h = '<div class="card mb-2 kanban-card ' + (editable ? '' : 'not-editable') + '" data-id="' + q.id + '" data-kind="request" '
          + 'style="border-left:3px solid #0dcaf0;' + (editable ? 'cursor:grab' : 'cursor:not-allowed;opacity:.5;filter:grayscale(60%)') + '">';
    h += '<div class="card-body p-2">';
    h += '<div class="small fw-semibold mb-1 d-flex align-items-center gap-1">';
    h += '<i class="fas fa-inbox text-info" style="font-size:.7rem" title="Talep"></i>';
    if (!editable) h += '<i class="fas fa-lock text-muted" style="font-size:.7rem"></i>';
    h += '<a href="/Requests/Detail/' + q.id + '" class="text-decoration-none">' + escHtml(q.title) + '</a></div>';
    h += '<div class="d-flex justify-content-between align-items-center">';
    h += '<span class="badge bg-light text-dark border">' + escHtml(q.sourceText) + '</span>';
    if (q.assignedEmployeeName) h += '<small class="text-muted">' + escHtml(q.assignedEmployeeName) + '</small>';
    h += '</div>';
    h += '<div class="small text-muted mt-1"><span class="badge bg-secondary" style="font-size:.6rem">' + escHtml(q.statusText) + '</span> · önem ' + q.priorityScore + '</div>';
    var overdue = q.isOverdue;
    if (q.dueDate) h += '<div class="small ' + (overdue ? 'text-danger' : 'text-muted') + '"><i class="far fa-calendar me-1"></i>' + new Date(q.dueDate).toLocaleDateString('tr-TR') + '</div>';
    h += '<div class="progress mt-1" style="height:4px"><div class="progress-bar bg-info" style="width:' + q.completionPercentage + '%"></div></div>';
    h += '</div></div>';
    return h;
}

function token() { return $('input[name="__RequestVerificationToken"]').val(); }

// Sunucudan dönen hata mesajını çeşitli zarf biçimlerinden ayıklar (ABP / custom).
function serverMsg(xhr, fb) {
    var j = xhr && xhr.responseJSON;
    if (j) {
        if (j.error && j.error.message) return j.error.message;   // ABP zarfı
        if (typeof j.error === 'string') return j.error;          // { error: "..." }
        if (j.result && j.result.error) return j.result.error;
        if (j.message) return j.message;
    }
    // Düz metin yanıt (ContentResult) — HTML hata sayfası değilse mesaj olarak kullan
    var txt = xhr && xhr.responseText;
    if (txt && txt.length > 0 && txt.length < 400 && txt.charAt(0) !== '<') return txt;
    return fb || 'İşlem gerçekleştirilemedi.';
}

function changeTaskStatus(id, status) {
    var t = tasks.find(function (x) { return x.id === id; });
    var pct = t ? t.completionPercentage : 0;
    if (status === 2) pct = 100;
    $.ajax({
        url: '/Tasks/UpdateStatus', type: 'POST',
        data: { id: id, status: status, percentage: pct, __RequestVerificationToken: token() },
        success: function () { abp.notify.success('Görev durumu güncellendi.'); loadBoard(); },
        error: function (xhr) { abp.notify.error(serverMsg(xhr, 'Güncellenemedi.')); loadBoard(); }
    });
}

function changeRequestStatus(id, status) {
    var q = requests.find(function (x) { return x.id === id; });
    var pct = q ? q.completionPercentage : 0;
    if (status === 4) pct = 100; // Çözüldü
    $.ajax({
        url: '/Requests/UpdateStatus', type: 'POST',
        data: { id: id, status: status, percentage: pct, returnUrl: '', __RequestVerificationToken: token() },
        success: function () { abp.notify.success('Talep durumu güncellendi.'); loadBoard(); },
        error: function (xhr) { abp.notify.error(serverMsg(xhr, 'Güncellenemedi.')); loadBoard(); }
    });
}
</script>
}

@model ActivityManagement.Search.Dto.GlobalSearchResultDto
@{
    ViewData["Title"] = "Arama";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var groups = new[]
    {
        ("Talepler", Model.Requests),
        ("Görevler", Model.Tasks),
        ("Faaliyetler", Model.Activities),
        ("Projeler", Model.Projects),
        ("Kişiler", Model.Employees)
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-search text-primary me-2"></i>Arama</h4>
</div>

<form method="get" action="/Search" class="mb-4" role="search">
    <div class="input-group input-group-lg" style="max-width:640px">
        <input type="text" name="q" class="form-control" value="@(Model.Query ?? "")" placeholder="Talep, görev, faaliyet, proje veya kişi ara..." autofocus />
        <button class="btn btn-primary" type="submit"><i class="fas fa-search me-1"></i>Ara</button>
    </div>
</form>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="text-muted"><i class="fas fa-circle-info me-1"></i>Aramak için en az 2 karakter girin.</div>
}
else if (Model.Total == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
        <strong>"@Model.Query"</strong> için sonuç bulunamadı.
    </div>
}
else
{
    <div class="small text-muted mb-3">"@Model.Query" için <strong>@Model.Total</strong> sonuç (görebildikleriniz).</div>
    <div class="row g-3">
        @foreach (var (title, items) in groups)
        {
            if (items != null && items.Count > 0)
            {
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="fas @items[0].Icon me-2 text-primary"></i>@title</span>
                            <span class="badge bg-secondary">@items.Count</span>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var it in items)
                            {
                                <li class="list-group-item">
                                    <a href="@it.Url" class="text-decoration-none fw-semibold">@it.Title</a>
                                    @if (!string.IsNullOrWhiteSpace(it.Subtitle))
                                    {
                                        <span class="text-muted small ms-1">— @it.Subtitle</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }
    </div>
}

@using ActivityManagement.Entities
@model ActivityManagement.ServiceRequests.Dto.ServiceRequestDto
@{
    ViewData["Title"] = "Talep Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var efforts = ViewBag.Efforts as System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityLogDto> ?? new();
    var types = ViewBag.ActivityTypes as System.Collections.Generic.IReadOnlyList<ActivityManagement.Activities.Dto.ActivityTypeDefDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>();
    var employees = ViewBag.Employees as System.Collections.Generic.IReadOnlyList<ActivityManagement.Employees.Dto.EmployeeDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>();
    var statuses = System.Enum.GetValues(typeof(RequestStatus)).Cast<RequestStatus>().ToList();
    var statusNames = new System.Collections.Generic.Dictionary<int,string> {
        {0,"Yeni"},{1,"Atandı"},{2,"Devam Ediyor"},{3,"Beklemede"},{4,"Çözüldü"},{5,"Kapandı"},{6,"İptal"}
    };
    string StatusColor(RequestStatus s) =>
        s == RequestStatus.Yeni ? "secondary" : s == RequestStatus.Atandi ? "info" :
        s == RequestStatus.DevamEdiyor ? "primary" : s == RequestStatus.Beklemede ? "warning" :
        s == RequestStatus.Cozuldu ? "success" : s == RequestStatus.Kapandi ? "dark" : "danger";
}

@* Yorum/açıklama taşma düzeltmesi: uzun kelime/URL kır, görseli sığdır *@
<style>
    .req-desc, .portal-comment-body { overflow-wrap: anywhere; word-break: break-word; max-width: 100%; }
    .req-desc img, .portal-comment-body img { max-width: 100%; height: auto; border-radius: 4px; }
    .req-desc pre, .portal-comment-body pre { white-space: pre-wrap; overflow-x: auto; }
    .req-desc table, .portal-comment-body table { max-width: 100%; }
    #wbCommentEditor .ql-editor { min-height: 90px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-inbox text-primary me-2"></i>@Model.Title</h4>
    <a href="/Requests" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Talepler</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><span class="badge bg-@StatusColor(Model.Status)">@Model.StatusText</span>
                      <span class="badge bg-light text-dark border ms-1">@Model.SourceText</span></span>
                @if (!string.IsNullOrEmpty(Model.ExternalUrl))
                {
                    <a href="@Model.ExternalUrl" target="_blank" rel="noopener" class="small">Portalda aç <i class="fas fa-external-link-alt fa-xs"></i></a>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">Talep No</dt><dd class="col-sm-9">@(Model.ExternalRef ?? "-")</dd>
                    <dt class="col-sm-3">Talep Eden</dt><dd class="col-sm-9">@(Model.RequesterName ?? "-") @(string.IsNullOrEmpty(Model.RequesterEmail) ? "" : $"({Model.RequesterEmail})")</dd>
                    <dt class="col-sm-3">Atanan</dt><dd class="col-sm-9">@(Model.AssignedEmployeeName ?? "<atanmadı>") @(string.IsNullOrEmpty(Model.SecondaryEmployeeName) ? "" : $"/ 2. {Model.SecondaryEmployeeName}")</dd>
                    <dt class="col-sm-3">Takım</dt><dd class="col-sm-9">@(Model.TeamName ?? "-")</dd>
                    <dt class="col-sm-3">Proje</dt><dd class="col-sm-9">@(Model.ProjectName ?? "-")</dd>
                    <dt class="col-sm-3">Faaliyet Tipi</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.ActivityType) ? "-" : Model.ActivityType)</dd>
                    <dt class="col-sm-3">Önem</dt><dd class="col-sm-9">@Model.PriorityScore / 10</dd>
                    <dt class="col-sm-3">Geliş</dt><dd class="col-sm-9">@(Model.ReceivedDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-3">SLA</dt><dd class="col-sm-9 @(Model.IsOverdue ? "text-danger fw-bold" : "")">@(Model.DueDate?.ToString("dd.MM.yyyy") ?? "-") @(Model.IsOverdue ? "(gecikti)" : "")</dd>
                    @if (!string.IsNullOrEmpty(Model.ExtraInfo))
                    {
                        <dt class="col-sm-3">Ek Bilgi</dt><dd class="col-sm-9">@Model.ExtraInfo</dd>
                    }
                    <dt class="col-sm-3">İlerleme</dt>
                    <dd class="col-sm-9">
                        <div class="progress" style="height:8px"><div class="progress-bar" style="width:@Model.CompletionPercentage%"></div></div>
                        <small class="text-muted">@Model.CompletionPercentage%</small>
                    </dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr /><div class="small req-desc">@Html.Raw(ActivityManagement.Web.Helpers.SafeHtml.RenderDescription(Model.Description))</div>
                }
            </div>
        </div>

        @* Durum güncelleme:
           - Manuel talep (portalsız): yerelde serbest.
           - Portal talebi + write-back AÇIK: yerelde değiştirilebilir → portala POST (MÜŞTERİYE e-posta gider; Çözüldü'de anket).
           - Portal talebi + write-back KAPALI: yalnız portaldan çekilir (salt-okunur bilgi notu). Her durumda efor bu ekrandan girilir. *@
        @if (Model.IsPortal && Model.SourceWriteBackEnabled && (Model.CanManage || Model.CanLogEffort))
        {
            <div class="card shadow-sm mb-3 border-warning">
                <div class="card-header"><i class="fas fa-flag me-2"></i>Durum Güncelle <small class="text-warning">(@Model.SourceText portalına işlenir)</small></div>
                <div class="card-body">
                    <div class="alert alert-warning py-1 px-2 small mb-2">
                        <i class="fas fa-triangle-exclamation me-1"></i>Bu değişiklik <strong>@Model.SourceText portalına işlenir</strong> ve <strong>talep edene e-posta</strong> gönderir (Çözüldü'de memnuniyet anketi).
                    </div>
                    <form method="post" action="/Requests/UpdatePortalStatus" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="col-md-6">
                            <label class="form-label small">Durum (@Model.SourceText)</label>
                            <select name="statusCode" class="form-select form-select-sm">
                                @foreach (var st in ActivityManagement.ServiceRequests.Dto.PortalStatusCatalog.Destek)
                                {
                                    <option value="@st.Code" selected="@(string.Equals(st.Label, Model.PortalStatusText, StringComparison.OrdinalIgnoreCase))">@st.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label small">Not (opsiyonel)</label><input type="text" name="note" class="form-control form-control-sm" placeholder="Duruma eklenecek not (müşteriye iletilebilir)" /></div>
                        <div class="col-12"><button class="btn btn-warning btn-sm"><i class="fas fa-paper-plane me-1"></i>Portala İşle</button></div>
                    </form>
                </div>
            </div>
        }
        else if (Model.IsPortal)
        {
            <div class="alert alert-info py-2 small mb-3">
                <i class="fas fa-arrows-rotate me-1"></i>Bu talebin <strong>durumu @Model.SourceText portalından otomatik güncellenir</strong> (senkron). Burada durum değiştirilmez; yalnızca <strong>efor</strong> girersiniz.
            </div>
        }
        else if (Model.CanManage || Model.CanLogEffort)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="fas fa-flag me-2"></i>Durum Güncelle <small class="text-muted">(manuel talep)</small></div>
                <div class="card-body">
                    <form method="post" action="/Requests/UpdateStatus" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="col-md-6">
                            <label class="form-label small">Durum</label>
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in statuses) { <option value="@((int)s)" selected="@(s == Model.Status)">@statusNames[(int)s]</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">İlerleme %</label>
                            <input type="number" name="percentage" class="form-control form-control-sm" min="0" max="100" step="5" value="@Model.CompletionPercentage" />
                        </div>
                        <div class="col-md-3"><button class="btn btn-primary btn-sm w-100">Güncelle</button></div>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanManage)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="fas fa-user-plus me-2"></i>Atama</div>
                <div class="card-body">
                    <form method="post" action="/Requests/Assign" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="col-md-5">
                            <label class="form-label small">Atanan</label>
                            <select name="assignedEmployeeId" class="form-select form-select-sm">
                                <option value="">— Yok —</option>
                                @foreach (var e in employees) { <option value="@e.Id" selected="@(e.Id == Model.AssignedEmployeeId)">@e.FullName</option> }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small">2. Sorumlu</label>
                            <select name="secondaryEmployeeId" class="form-select form-select-sm">
                                <option value="">— Yok —</option>
                                @foreach (var e in employees) { <option value="@e.Id" selected="@(e.Id == Model.SecondaryEmployeeId)">@e.FullName</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><button class="btn btn-primary btn-sm w-100">Ata</button></div>
                    </form>
                </div>
            </div>
        }

        @* (C12) Portal aynası: yorumlar (salt-okunur; @Model.SourceText portalından senkron) *@
        @if (Model.Comments != null && Model.Comments.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-comments me-2"></i>Portal Yorumları</span>
                    <span class="badge bg-secondary">@Model.Comments.Count</span>
                </div>
                <div class="card-body">
                    @foreach (var c in Model.Comments)
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="small fw-bold">@(string.IsNullOrWhiteSpace(c.AuthorName) ? (c.AuthorEmail ?? "-") : c.AuthorName)
                                    @if (c.IsInternal) { <span class="badge bg-warning text-dark ms-1">iç not</span> }
                                </span>
                                <small class="text-muted">@(c.CommentDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</small>
                            </div>
                            <div class="small req-desc portal-comment-body mt-1">@Html.Raw(ActivityManagement.Web.Helpers.SafeHtml.RenderDescription(c.Body))</div>
                        </div>
                    }
                </div>
            </div>
        }

        @* (C12) Portal dosya ekleri (salt-okunur bağlantı) *@
        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-paperclip me-2"></i>Portal Dosya Ekleri</span>
                    <span class="badge bg-secondary">@Model.Attachments.Count</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var a in Model.Attachments)
                    {
                        var kb = a.SizeBytes > 0 ? $"{(a.SizeBytes / 1024.0):0.#} KB" : "";
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                            <span class="small text-truncate" style="max-width:75%">
                                <i class="fas fa-file me-1 text-muted"></i>
                                @if (!string.IsNullOrWhiteSpace(a.Url))
                                {
                                    <a href="/Requests/Attachment/@Model.Id?attId=@a.Id" target="_blank" rel="noopener">@(a.FileName ?? "dosya")</a>
                                }
                                else
                                {
                                    @(a.FileName ?? "dosya")
                                }
                            </span>
                            <small class="text-muted">@kb</small>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-clock me-2"></i>Efor Kayıtları</span>
                <span class="badge bg-primary">@Model.TotalHours.ToString("0.##") saat</span>
            </div>
            <div class="card-body">
                @if (Model.CanLogEffort)
                {
                    <form method="post" action="/Requests/LogEffort" class="border-bottom pb-3 mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceRequestId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label small">Tarih</label><input type="date" name="activityDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                            <div class="col-6"><label class="form-label small">Süre (saat)</label><input type="number" name="hoursSpent" class="form-control form-control-sm" step="0.25" min="0.25" value="1" required /></div>
                            <div class="col-12"><label class="form-label small">Faaliyet Tipi</label>
                                <select name="activityType" class="form-select form-select-sm">
                                    <option value="Talep" selected="@(string.IsNullOrEmpty(Model.ActivityType))">Talep</option>
                                    @foreach (var t in types) { <option value="@t.Name" selected="@(t.Name == Model.ActivityType)">@t.Name</option> }
                                </select>
                            </div>
                            <div class="col-12"><label class="form-label small">Açıklama</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
                            <div class="col-12"><button class="btn btn-success btn-sm w-100"><i class="fas fa-plus me-1"></i>Efor Ekle</button></div>
                        </div>
                    </form>
                }
                @if (!efforts.Any())
                {
                    <p class="text-muted small mb-0">Henüz efor girilmemiş.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in efforts)
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <span><strong>@e.HoursSpent.ToString("0.##") sa</strong> <small class="text-muted">@e.ActivityType</small></span>
                                    <small class="text-muted">@e.ActivityDate.ToString("dd.MM.yyyy")</small>
                                </div>
                                <small class="text-muted d-block">@e.EmployeeName</small>
                                @if (!string.IsNullOrWhiteSpace(e.Description)) { <small class="d-block">@e.Description</small> }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* (C13) Yorum / Not — efor alanının yanında. Portal talebinde herkese (yönetici/atanan) görünür.
           İç not: write-back kapalıysa yalnız yerel; açıksa portala dahili. Dış not: write-back gerektirir → müşteriye e-posta. *@
        @if (Model.IsPortal && (Model.CanManage || Model.CanLogEffort))
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="fas fa-reply me-2"></i>Yorum / Not Ekle <small class="text-muted">(@Model.SourceText)</small></div>
                <div class="card-body">
                    <form method="post" action="/Requests/AddComment" id="wbCommentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <input type="hidden" name="body" id="wbCommentHtml" />
                        <div id="wbCommentEditor" style="height:120px; background:#fff"></div>
                        <div class="mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isInternal" value="true" id="wbIc" checked />
                                <label class="form-check-label small" for="wbIc"><span class="badge bg-warning text-dark">İç not</span> Dahili — <strong>son kullanıcıya gitmez</strong>@(Model.SourceWriteBackEnabled ? " (portala dahili iletilir)" : " (yalnız bizim sistemde)")</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isInternal" value="false" id="wbDis" @(Model.SourceWriteBackEnabled ? "" : "disabled") />
                                <label class="form-check-label small @(Model.SourceWriteBackEnabled ? "" : "text-muted")" for="wbDis"><span class="badge bg-success">Dış not</span> Müşteriye açık — <strong>talep edene e-posta gönderilir</strong></label>
                            </div>
                        </div>
                        @if (Model.SourceWriteBackEnabled)
                        {
                            <div class="small text-muted my-2"><i class="fas fa-image me-1"></i>Ctrl+V ile ekran görüntüsü; kalın/italik/liste desteklenir. <em>(Görseller bizde saklanır; @Model.SourceText portalına metin/biçim iletilir.)</em></div>
                        }
                        else
                        {
                            <div class="alert alert-light border py-1 px-2 small my-2"><i class="fas fa-circle-info me-1"></i><strong>Dış not</strong> (portala + müşteriye) için write-back kapalı. İç not olarak kaydedebilirsiniz; <strong>Admin → Entegrasyon</strong>'dan write-back açılınca dış not da gönderilir.</div>
                        }
                        <button class="btn btn-primary btn-sm" id="wbSubmit"><i class="fas fa-paper-plane me-1"></i>Gönder</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @* Yorum write-back için Rich Text editör (Quill) — görev yorumuyla aynı; Ctrl+V ekran görüntüsü desteklenir *@
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            var el = document.getElementById('wbCommentEditor');
            if (!el || typeof Quill === 'undefined') return;
            var quill = new Quill('#wbCommentEditor', {
                theme: 'snow',
                placeholder: 'Yorum / not... (Ctrl+V ile ekran görüntüsü yapıştırabilirsiniz)',
                modules: { toolbar: [['bold', 'italic', 'underline'], ['link', 'image'], [{ 'list': 'ordered' }, { 'list': 'bullet' }], ['clean']] }
            });
            var form = document.getElementById('wbCommentForm');
            form.addEventListener('submit', function (e) {
                var isEmpty = quill.getText().trim() === '' && quill.root.querySelectorAll('img').length === 0;
                if (isEmpty) { e.preventDefault(); alert('Yorum boş olamaz.'); return false; }
                document.getElementById('wbCommentHtml').value = quill.root.innerHTML;
                // Dış not seçiliyse müşteriye e-posta gideceği için onay iste
                var dis = document.getElementById('wbDis');
                if (dis && dis.checked && !confirm('Bu DIŞ NOT olarak gönderilecek ve talep edene e-posta gidecek. Onaylıyor musunuz?')) {
                    e.preventDefault(); return false;
                }
            });
        })();
    </script>
}

@using ActivityManagement.Entities
@model ActivityManagement.ServiceRequests.Dto.ServiceRequestDto
@{
    ViewData["Title"] = "Talep Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var efforts = ViewBag.Efforts as System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityLogDto> ?? new();
    var types = ViewBag.ActivityTypes as System.Collections.Generic.IReadOnlyList<ActivityManagement.Activities.Dto.ActivityTypeDefDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>();
    var employees = ViewBag.Employees as System.Collections.Generic.IReadOnlyList<ActivityManagement.Employees.Dto.EmployeeDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>();
    var statuses = System.Enum.GetValues(typeof(RequestStatus)).Cast<RequestStatus>().ToList();
    var statusNames = new System.Collections.Generic.Dictionary<int,string> {
        {0,"Yeni"},{1,"Atandı"},{2,"Devam Ediyor"},{3,"Beklemede"},{4,"Çözüldü"},{5,"Kapandı"},{6,"İptal"}
    };
    string StatusColor(RequestStatus s) =>
        s == RequestStatus.Yeni ? "secondary" : s == RequestStatus.Atandi ? "info" :
        s == RequestStatus.DevamEdiyor ? "primary" : s == RequestStatus.Beklemede ? "warning" :
        s == RequestStatus.Cozuldu ? "success" : s == RequestStatus.Kapandi ? "dark" : "danger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-inbox text-primary me-2"></i>@Model.Title</h4>
    <a href="/Requests" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Talepler</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><span class="badge bg-@StatusColor(Model.Status)">@Model.StatusText</span>
                      <span class="badge bg-light text-dark border ms-1">@Model.SourceText</span></span>
                @if (!string.IsNullOrEmpty(Model.ExternalUrl))
                {
                    <a href="@Model.ExternalUrl" target="_blank" rel="noopener" class="small">Portalda aç <i class="fas fa-external-link-alt fa-xs"></i></a>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">Talep No</dt><dd class="col-sm-9">@(Model.ExternalRef ?? "-")</dd>
                    <dt class="col-sm-3">Talep Eden</dt><dd class="col-sm-9">@(Model.RequesterName ?? "-") @(string.IsNullOrEmpty(Model.RequesterEmail) ? "" : $"({Model.RequesterEmail})")</dd>
                    <dt class="col-sm-3">Atanan</dt><dd class="col-sm-9">@(Model.AssignedEmployeeName ?? "<atanmadı>") @(string.IsNullOrEmpty(Model.SecondaryEmployeeName) ? "" : $"/ 2. {Model.SecondaryEmployeeName}")</dd>
                    <dt class="col-sm-3">Takım</dt><dd class="col-sm-9">@(Model.TeamName ?? "-")</dd>
                    <dt class="col-sm-3">Proje</dt><dd class="col-sm-9">@(Model.ProjectName ?? "-")</dd>
                    <dt class="col-sm-3">Faaliyet Tipi</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.ActivityType) ? "-" : Model.ActivityType)</dd>
                    <dt class="col-sm-3">Önem</dt><dd class="col-sm-9">@Model.PriorityScore / 10</dd>
                    <dt class="col-sm-3">Geliş</dt><dd class="col-sm-9">@(Model.ReceivedDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-3">SLA</dt><dd class="col-sm-9 @(Model.IsOverdue ? "text-danger fw-bold" : "")">@(Model.DueDate?.ToString("dd.MM.yyyy") ?? "-") @(Model.IsOverdue ? "(gecikti)" : "")</dd>
                    @if (!string.IsNullOrEmpty(Model.ExtraInfo))
                    {
                        <dt class="col-sm-3">Ek Bilgi</dt><dd class="col-sm-9">@Model.ExtraInfo</dd>
                    }
                    <dt class="col-sm-3">İlerleme</dt>
                    <dd class="col-sm-9">
                        <div class="progress" style="height:8px"><div class="progress-bar" style="width:@Model.CompletionPercentage%"></div></div>
                        <small class="text-muted">@Model.CompletionPercentage%</small>
                    </dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr /><div class="small req-desc">@Html.Raw(ActivityManagement.Web.Helpers.SafeHtml.RenderDescription(Model.Description))</div>
                }
            </div>
        </div>

        @if (Model.CanManage || Model.CanLogEffort)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="fas fa-flag me-2"></i>Durum Güncelle</div>
                <div class="card-body">
                    <form method="post" action="/Requests/UpdateStatus" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="col-md-6">
                            <label class="form-label small">Durum</label>
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in statuses) { <option value="@((int)s)" selected="@(s == Model.Status)">@statusNames[(int)s]</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">İlerleme %</label>
                            <input type="number" name="percentage" class="form-control form-control-sm" min="0" max="100" step="5" value="@Model.CompletionPercentage" />
                        </div>
                        <div class="col-md-3"><button class="btn btn-primary btn-sm w-100">Güncelle</button></div>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanManage)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="fas fa-user-plus me-2"></i>Atama</div>
                <div class="card-body">
                    <form method="post" action="/Requests/Assign" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="col-md-5">
                            <label class="form-label small">Atanan</label>
                            <select name="assignedEmployeeId" class="form-select form-select-sm">
                                <option value="">— Yok —</option>
                                @foreach (var e in employees) { <option value="@e.Id" selected="@(e.Id == Model.AssignedEmployeeId)">@e.FullName</option> }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small">2. Sorumlu</label>
                            <select name="secondaryEmployeeId" class="form-select form-select-sm">
                                <option value="">— Yok —</option>
                                @foreach (var e in employees) { <option value="@e.Id" selected="@(e.Id == Model.SecondaryEmployeeId)">@e.FullName</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><button class="btn btn-primary btn-sm w-100">Ata</button></div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-clock me-2"></i>Efor Kayıtları</span>
                <span class="badge bg-primary">@Model.TotalHours.ToString("0.##") saat</span>
            </div>
            <div class="card-body">
                @if (Model.CanLogEffort)
                {
                    <form method="post" action="/Requests/LogEffort" class="border-bottom pb-3 mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceRequestId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Requests/Detail/@Model.Id" />
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label small">Tarih</label><input type="date" name="activityDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                            <div class="col-6"><label class="form-label small">Süre (saat)</label><input type="number" name="hoursSpent" class="form-control form-control-sm" step="0.25" min="0.25" value="1" required /></div>
                            <div class="col-12"><label class="form-label small">Faaliyet Tipi</label>
                                <select name="activityType" class="form-select form-select-sm">
                                    <option value="Talep" selected="@(string.IsNullOrEmpty(Model.ActivityType))">Talep</option>
                                    @foreach (var t in types) { <option value="@t.Name" selected="@(t.Name == Model.ActivityType)">@t.Name</option> }
                                </select>
                            </div>
                            <div class="col-12"><label class="form-label small">Açıklama</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
                            <div class="col-12"><button class="btn btn-success btn-sm w-100"><i class="fas fa-plus me-1"></i>Efor Ekle</button></div>
                        </div>
                    </form>
                }
                @if (!efforts.Any())
                {
                    <p class="text-muted small mb-0">Henüz efor girilmemiş.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in efforts)
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <span><strong>@e.HoursSpent.ToString("0.##") sa</strong> <small class="text-muted">@e.ActivityType</small></span>
                                    <small class="text-muted">@e.ActivityDate.ToString("dd.MM.yyyy")</small>
                                </div>
                                <small class="text-muted d-block">@e.EmployeeName</small>
                                @if (!string.IsNullOrWhiteSpace(e.Description)) { <small class="d-block">@e.Description</small> }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

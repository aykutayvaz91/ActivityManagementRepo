@using ActivityManagement.Entities
@model System.Collections.Generic.List<ActivityManagement.ServiceRequests.Dto.ServiceRequestDto>
@{
    ViewData["Title"] = "Talep Sorgula";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var input = ViewBag.Input as ActivityManagement.ServiceRequests.Dto.GetServiceRequestsInput
                ?? new ActivityManagement.ServiceRequests.Dto.GetServiceRequestsInput();
    var employees = ViewBag.Employees as System.Collections.Generic.IReadOnlyList<ActivityManagement.Employees.Dto.EmployeeDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>();
    var statusNames = new System.Collections.Generic.Dictionary<int, string> {
        {0,"Yeni"},{1,"Atandı"},{2,"Devam Ediyor"},{3,"Beklemede"},{4,"Çözüldü"},{5,"Kapandı"},{6,"İptal"}
    };
    ViewData["ReadOnly"] = true;  // sorgu ekranı: yalnız Detay (işlem butonları yok)
    string qs = $"source={(input.Source.HasValue ? ((int)input.Source.Value).ToString() : "")}&status={(input.Status.HasValue ? ((int)input.Status.Value).ToString() : "")}&assignedEmployeeId={input.AssignedEmployeeId}&filter={System.Net.WebUtility.UrlEncode(input.Filter ?? "")}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-magnifying-glass text-primary me-2"></i>Talep Sorgula</h2>
    <div class="d-flex gap-2">
        <a href="/Requests" class="btn btn-outline-secondary"><i class="fas fa-inbox me-1"></i>Talepler</a>
        <a href="/Requests/ExportQueryExcel?@qs" class="btn btn-outline-success"><i class="fas fa-file-excel me-1"></i>Excel</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" action="/Requests/Query" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small">Kaynak</label>
                <select name="source" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    <option value="0" selected="@(input.Source == RequestSource.SunucuKurulum)">Sunucu Kurulum</option>
                    <option value="1" selected="@(input.Source == RequestSource.DisDestek)">Dış Destek</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Durum</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    @foreach (var kv in statusNames)
                    {
                        <option value="@kv.Key" selected="@((int?)input.Status == kv.Key)">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Atanan Kişi</label>
                <select name="assignedEmployeeId" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    @foreach (var e in employees)
                    {
                        <option value="@e.Id" selected="@(input.AssignedEmployeeId == e.Id)">@e.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Ara <small class="text-muted">(başlık / talep no / talep eden)</small></label>
                <input name="filter" class="form-control form-control-sm" value="@input.Filter" placeholder="metin..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100"><i class="fas fa-search me-1"></i>Sorgula</button>
            </div>
        </form>
    </div>
</div>

<div class="mb-2 text-muted small"><i class="fas fa-list me-1"></i>@Model.Count kayıt (arşiv/kapalı dahil tüm durumlar)</div>

<div class="card shadow-sm">
    <div class="card-body p-2">
        @await Html.PartialAsync("_RequestTable", Model)
    </div>
</div>

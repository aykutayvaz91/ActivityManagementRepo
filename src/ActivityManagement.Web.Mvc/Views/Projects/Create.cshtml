@model ActivityManagement.Projects.Dto.CreateUpdateProjectDto
@{
    ViewData["Title"] = "Yeni Proje";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employees = ViewBag.Employees as IList<ActivityManagement.Employees.Dto.EmployeeDto>;
    var categories = ViewBag.Categories as System.Collections.Generic.List<ActivityManagement.Categories.Dto.CategoryDto>
                     ?? new System.Collections.Generic.List<ActivityManagement.Categories.Dto.CategoryDto>();
    bool isManager = User.IsInRole("Admin") || User.IsInRole("TakımLideri");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Projects">Projeler</a></li>
            <li class="breadcrumb-item active">Yeni Proje</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Yeni Proje Oluştur</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Proje Adı <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Proje Kodu</label>
                            <input asp-for="Code" class="form-control bg-light" readonly />
                            <small class="text-muted">Otomatik atanır (sıradaki numara).</small>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ana Kategori <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" id="categorySelect" class="form-select" required>
                                <option value="">— Seçiniz —</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Alt Kategori <span class="text-danger">*</span></label>
                            <select asp-for="SubCategoryId" id="subCategorySelect" class="form-select" required>
                                <option value="">— Önce ana kategori —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PlannedEndDate" class="form-label">Planlanan Bitiş</label>
                            <input asp-for="PlannedEndDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="SlaTargetDate" class="form-label">SLA / Hedef Bitiş <span class="text-danger">*</span></label>
                            <input asp-for="SlaTargetDate" class="form-control" type="date" required />
                            <small class="text-muted">Proje görevlerine son tarih girilmezse bu tarih atanır.</small>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label">Durum</label>
                            <select asp-for="Status" class="form-select">
                                <option value="0">Planlandı</option>
                                <option value="1">Devam Ediyor</option>
                                <option value="2">Tamamlandı</option>
                                <option value="3">İptal</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label">Öncelik</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="1">Düşük</option>
                                <option value="2">Normal</option>
                                <option value="3">Yüksek</option>
                                <option value="4">Kritik</option>
                            </select>
                        </div>
                        @if (isManager)
                        {
                            <div class="col-md-4">
                                <label asp-for="PrimaryResponsibleId" class="form-label">1. Sorumlu</label>
                                <select asp-for="PrimaryResponsibleId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (employees != null)
                                    {
                                        foreach (var emp in employees)
                                        {
                                            <option value="@emp.Id">@emp.FullName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SecondaryResponsibleId" class="form-label">2. Sorumlu</label>
                                <select asp-for="SecondaryResponsibleId" class="form-select">
                                    <option value="">Seçiniz...</option>
                                    @if (employees != null)
                                    {
                                        foreach (var emp in employees)
                                        {
                                            <option value="@emp.Id">@emp.FullName</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input asp-for="PrimaryResponsibleId" type="hidden" />
                            <div class="col-md-4">
                                <label class="form-label">1. Sorumlu</label>
                                <input class="form-control" value="Siz" disabled />
                                <small class="text-muted">Oluşturduğunuz proje otomatik olarak size (1. sorumlu) atanır.</small>
                            </div>
                        }
                    </div>

                    <hr />
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="/Projects" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        var data = @Html.Raw(ActivityManagement.Web.Utils.JsonHelper.ToCamelCaseJson(categories));
        var cat = document.getElementById('categorySelect');
        var sub = document.getElementById('subCategorySelect');
        var preSub = '@(Model.SubCategoryId?.ToString() ?? "")';
        function find(id){ for (var i=0;i<data.length;i++) if (String(data[i].id)===String(id)) return data[i]; return null; }
        function fill(selSub) {
            var c = find(cat.value); sub.innerHTML='';
            if (!c) { sub.appendChild(new Option('— Önce ana kategori —','')); return; }
            sub.appendChild(new Option('Seçiniz...',''));
            (c.subCategories||[]).forEach(function(s){ var o=new Option(s.name,s.id); if(selSub&&String(s.id)===String(selSub))o.selected=true; sub.appendChild(o); });
        }
        cat.addEventListener('change', function(){ fill(null); });
        if (cat.value) fill(preSub);
    })();
    </script>
}

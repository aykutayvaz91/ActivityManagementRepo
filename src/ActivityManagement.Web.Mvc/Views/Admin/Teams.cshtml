@model System.Collections.Generic.List<ActivityManagement.Teams.Dto.TeamDto>
@{
    ViewData["Title"] = "Takım Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var employees = ViewBag.Employees as System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>
                    ?? new System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Admin">Admin Panel</a></li>
            <li class="breadcrumb-item active">Takım Yönetimi</li>
        </ol>
    </nav>
</div>


<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent"><h6 class="mb-0"><i class="fas fa-people-group me-2 text-primary"></i>Takımlar</h6></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Ad</th><th>Takım Lideri</th><th>Üye</th><th>Proje</th><th>Aktif</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@t.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                    {
                                        <div class="small text-muted">@t.Description</div>
                                    }
                                </td>
                                <td>@(t.LeaderName ?? "—")</td>
                                <td>@t.MemberCount</td>
                                <td>@t.ProjectCount</td>
                                <td>@(t.IsActive ? "✓" : "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning"
                                            onclick='editTeam(@Html.Raw(ActivityManagement.Web.Utils.JsonHelper.ToCamelCaseJson(t)))'>
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="DeleteTeam" method="post" class="d-inline" onsubmit="return confirm('Takım silinsin mi? (Üyeleri/projeleri takımsız kalır)')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-transparent"><h6 class="mb-0"><i class="fas fa-user-friends me-2 text-secondary"></i>Çalışan - Takım Atama</h6></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Çalışan</th><th>Mevcut Takım</th><th style="width:260px"></th></tr></thead>
                    <tbody>
                        @foreach (var e in employees)
                        {
                            <tr>
                                <td>@e.FullName</td>
                                <td>@(e.TeamName ?? "—")</td>
                                <td>
                                    <form asp-action="AssignEmployeeTeam" method="post" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="employeeId" value="@e.Id" />
                                        <select name="teamId" class="form-select form-select-sm">
                                            <option value="">— Takımsız —</option>
                                            @foreach (var t in Model)
                                            {
                                                <option value="@t.Id" selected="@(e.TeamId == t.Id)">@t.Name</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Ata</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white"><h6 class="mb-0" id="formTitle">Yeni Takım</h6></div>
            <div class="card-body">
                <form asp-action="SaveTeam" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="f_id" value="0" />
                    <div class="mb-2">
                        <label class="form-label small">Ad</label>
                        <input name="Name" id="f_name" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Açıklama</label>
                        <textarea name="Description" id="f_desc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Takım Lideri</label>
                        <select name="LeaderId" id="f_leader" class="form-select">
                            <option value="">— Seçiniz —</option>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id">@e.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3"><input type="checkbox" name="IsActive" value="true" id="f_active" class="form-check-input" checked /><label class="form-check-label" for="f_active">Aktif</label></div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-save me-1"></i>Kaydet</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">Temizle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function editTeam(t) {
    document.getElementById('formTitle').innerText = 'Takım Düzenle: ' + t.name;
    document.getElementById('f_id').value = t.id;
    document.getElementById('f_name').value = t.name;
    document.getElementById('f_desc').value = t.description || '';
    document.getElementById('f_leader').value = t.leaderId || '';
    document.getElementById('f_active').checked = t.isActive;
    window.scrollTo(0, 0);
}
function resetForm() {
    document.getElementById('formTitle').innerText = 'Yeni Takım';
    document.getElementById('f_id').value = 0;
    document.getElementById('f_name').value = '';
    document.getElementById('f_desc').value = '';
    document.getElementById('f_leader').value = '';
    document.getElementById('f_active').checked = true;
}
</script>
}

@{
    ViewData["Title"] = "Admin Panel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-shield text-primary me-2"></i>Admin Panel</h2>
    <span class="badge bg-danger">Yönetici</span>
</div>

@{
    var actingAsName = ViewBag.ActingAsName as string;
    var actingAsId = ViewBag.ActingAsId as long?;
    var actAsEmployees = ViewBag.ActAsEmployees as System.Collections.Generic.IReadOnlyList<ActivityManagement.Employees.Dto.EmployeeDto>
                         ?? new System.Collections.Generic.List<ActivityManagement.Employees.Dto.EmployeeDto>();
}
<div class="card border-primary shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <i class="fas fa-user-secret me-2 text-primary"></i>
                <strong>Kişi Olarak İşlem Yap (Login as)</strong>
                <div class="small text-muted mt-1">
                    Şu an:
                    @if (!string.IsNullOrEmpty(actingAsName))
                    {
                        <span class="badge bg-primary">@actingAsName</span>
                        @if (actingAsId.HasValue)
                        {
                            <a href="/Employees/Card/@actingAsId" class="ms-1">kartı</a>
                        }
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">bağlı kişi yok</span>
                    }
                </div>
                <div class="small text-muted">Görev/efor gibi kişisel işlemler seçili kişi adına kaydedilir.</div>
            </div>
            <div class="col-md-7">
                <form asp-action="ActAs" method="post" class="d-flex gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <select name="employeeId" class="form-select form-select-sm" required>
                        <option value="">Personel seçin…</option>
                        @foreach (var e in actAsEmployees.OrderBy(x => x.FullName))
                        {
                            <option value="@e.Id" selected="@(actingAsId.HasValue && actingAsId.Value == e.Id)">@e.FullName@(string.IsNullOrEmpty(e.Title) ? "" : " — " + e.Title)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="fas fa-right-left me-1"></i>Geç</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm"><div class="card-body text-center">
            <i class="fas fa-users fa-2x mb-2 opacity-75"></i>
            <div class="h3 mb-0">@ViewBag.EmployeeCount</div><div>Çalışan</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm"><div class="card-body text-center">
            <i class="fas fa-project-diagram fa-2x mb-2 opacity-75"></i>
            <div class="h3 mb-0">@ViewBag.ProjectCount</div><div>Proje</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow-sm"><div class="card-body text-center">
            <i class="fas fa-tasks fa-2x mb-2 opacity-75"></i>
            <div class="h3 mb-0">@ViewBag.TaskCount</div><div>Görev</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white shadow-sm"><div class="card-body text-center">
            <i class="fas fa-user-shield fa-2x mb-2 opacity-75"></i>
            <div class="h3 mb-0">@ViewBag.AdminCount</div><div>Admin</div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-user-tag text-primary me-2"></i>Rol Yönetimi</h6>
            <p class="text-muted small">Çalışanlara Admin / Takım Lideri / Uzman rolü ata.</p>
            <a href="/Admin/Roles" class="btn btn-sm btn-primary">Rolleri Yönet</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-users text-success me-2"></i>Çalışanlar</h6>
            <p class="text-muted small">Çalışan ekle, düzenle, sil; kişi kartlarını gör.</p>
            <a href="/Employees" class="btn btn-sm btn-success">Çalışanlar</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-project-diagram text-info me-2"></i>Projeler</h6>
            <p class="text-muted small">Proje oluştur, üye ata, durum yönet.</p>
            <a href="/Projects" class="btn btn-sm btn-info text-white">Projeler</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-clipboard-list text-warning me-2"></i>Görevler</h6>
            <p class="text-muted small">Görev oluştur, ata ve takip et.</p>
            <a href="/Tasks" class="btn btn-sm btn-warning">Görevler</a>
            <a href="/Tasks/Board" class="btn btn-sm btn-outline-warning">Pano</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-columns text-danger me-2"></i>Durum Yönetimi</h6>
            <p class="text-muted small">Kanban kolonlarını (görev durumlarını) düzenle: ad, renk, sıra, görünürlük.</p>
            <a href="/Admin/Statuses" class="btn btn-sm btn-danger">Durumları Yönet</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-people-group text-dark me-2"></i>Takım Yönetimi</h6>
            <p class="text-muted small">Takım oluştur, takım lideri ata, çalışanları takımlara dağıt.</p>
            <a href="/Admin/Teams" class="btn btn-sm btn-dark">Takımları Yönet</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-sitemap text-primary me-2"></i>Kategori Yönetimi</h6>
            <p class="text-muted small">Ana kategori/alt kategori tanımla, ana kategorinin 1./2. sorumlusunu ata.</p>
            <a href="/Admin/Categories" class="btn btn-sm btn-primary">Kategorileri Yönet</a>
        </div></div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-user-shield text-success me-2"></i>Sorumluluk Matrisi</h6>
            <p class="text-muted small">Alt kategori bazında personele Asıl/Yedek sorumlu ata (ekip dağılımı).</p>
            <a href="/Admin/Responsibilities" class="btn btn-sm btn-success">Sorumluluk Matrisi</a>
        </div></div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6><i class="fas fa-tags text-warning me-2"></i>Faaliyet Tipleri</h6>
                <p class="text-muted small">Faaliyet/efor girişinde kullanılan tipleri (Destek, Bakım, Toplantı...) yönet.</p>
                <a href="/Admin/ActivityTypes" class="btn btn-sm btn-warning text-dark">Faaliyet Tipleri</a>
            </div></div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6><i class="fas fa-palette text-primary me-2"></i>Tema & Logo</h6>
                <p class="text-muted small">Sistemin ana rengini (RGB/Hex), marka adını ve şirket logosunu özelleştir.</p>
                <a href="/Admin/Theme" class="btn btn-sm btn-primary">Tema Ayarları</a>
            </div></div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6><i class="fas fa-user-lock text-danger me-2"></i>Rol & Sayfa Erişimi</h6>
                <p class="text-muted small">Rollerin hangi sayfaları göreceğini matristen ayarla; yeni ara/özel rol tanımla.</p>
                <a href="/Admin/RoleAccess" class="btn btn-sm btn-danger">Rol & Erişim</a>
            </div></div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6><i class="fas fa-envelope-open-text text-info me-2"></i>E-posta / SMTP Ayarları</h6>
                <p class="text-muted small">Sistem e-postalarının gönderileceği SMTP sunucusunu yapılandır, test et.</p>
                <a href="/Admin/EmailSettings" class="btn btn-sm btn-info text-white">E-posta Ayarları</a>
            </div></div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6><i class="fas fa-clipboard-list text-dark me-2"></i>Sistem Logları (Audit)</h6>
                <p class="text-muted small">Tüm ekleme/güncelleme/silme hareketleri, eski/yeni değer karşılaştırması, filtre + Excel.</p>
                <a href="/Admin/SystemLogs" class="btn btn-sm btn-dark">Sistem Logları</a>
            </div></div>
        </div>
    }
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h6><i class="fas fa-chart-bar text-secondary me-2"></i>Raporlar</h6>
            <p class="text-muted small">Kişisel ve ekip faaliyet raporları.</p>
            <a href="/Reports/Team" class="btn btn-sm btn-secondary">Ekip Raporu</a>
        </div></div>
    </div>
</div>

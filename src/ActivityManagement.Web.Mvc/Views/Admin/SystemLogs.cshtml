@model System.Collections.Generic.IReadOnlyList<ActivityManagement.Auditing.Dto.AuditLogDto>
@{
    ViewData["Title"] = "Sistem Logları";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var input = ViewBag.Input as ActivityManagement.Auditing.Dto.GetAuditLogsInput ?? new ActivityManagement.Auditing.Dto.GetAuditLogsInput();
    var total = (int)(ViewBag.TotalCount ?? 0);
    string ActBadge(string a) => a == "Create" ? "success" : a == "Update" ? "warning" : a == "Delete" ? "danger" : "secondary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Admin">Admin Panel</a></li>
            <li class="breadcrumb-item active">Sistem Logları</li>
        </ol>
    </nav>
    <a href="/Admin/ExportSystemLogsExcel?startDate=@(input.StartDate?.ToString("yyyy-MM-dd"))&endDate=@(input.EndDate?.ToString("yyyy-MM-dd"))&userName=@input.UserName&actionType=@input.ActionType&entityName=@input.EntityName"
       class="btn btn-success btn-sm"><i class="fas fa-file-excel me-1"></i>Excel</a>
</div>

<div class="card mb-3 border-0 shadow-sm">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small">Başlangıç</label>
                <input type="date" name="StartDate" class="form-control form-control-sm" value="@input.StartDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Bitiş</label>
                <input type="date" name="EndDate" class="form-control form-control-sm" value="@input.EndDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Kullanıcı</label>
                <input type="text" name="UserName" class="form-control form-control-sm" value="@input.UserName" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">İşlem</label>
                <select name="ActionType" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    <option value="Create" selected="@(input.ActionType == "Create")">Ekleme</option>
                    <option value="Update" selected="@(input.ActionType == "Update")">Güncelleme</option>
                    <option value="Delete" selected="@(input.ActionType == "Delete")">Silme</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Varlık</label>
                <input type="text" name="EntityName" class="form-control form-control-sm" value="@input.EntityName" placeholder="TaskItem, Project..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-primary w-100"><i class="fas fa-search me-1"></i>Filtrele</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Tarih/Saat</th><th>Kullanıcı</th><th>İşlem</th><th>Varlık</th><th>Kayıt</th><th>Değişiklik</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                }
                @{ int idx = 0; }
                @foreach (var a in Model)
                {
                    idx++;
                    <tr>
                        <td class="small text-nowrap">@a.ExecutionTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="small">@(a.UserName ?? "sistem")<br /><span class="text-muted" style="font-size:.7rem">@a.ClientIpAddress</span></td>
                        <td><span class="badge bg-@ActBadge(a.ActionType)">@a.ActionType</span></td>
                        <td class="small">@a.EntityName</td>
                        <td class="small">@a.EntityId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(a.OriginalValues) || !string.IsNullOrEmpty(a.NewValues))
                            {
                                <button class="btn btn-sm btn-outline-secondary py-0" type="button" data-bs-toggle="collapse" data-bs-target="#diff@idx">
                                    <i class="fas fa-code"></i> Diff
                                </button>
                                <div class="collapse mt-1" id="diff@idx">
                                    <div class="row g-2" style="min-width:420px">
                                        <div class="col-6">
                                            <div class="small text-muted">Eski</div>
                                            <pre class="bg-light p-2 rounded small mb-0" style="max-height:200px;overflow:auto">@a.OriginalValues</pre>
                                        </div>
                                        <div class="col-6">
                                            <div class="small text-muted">Yeni</div>
                                            <pre class="bg-light p-2 rounded small mb-0" style="max-height:200px;overflow:auto">@a.NewValues</pre>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">Toplam @total kayıt (en son 100 gösteriliyor; filtre ile daraltın veya Excel'e aktarın).</p>

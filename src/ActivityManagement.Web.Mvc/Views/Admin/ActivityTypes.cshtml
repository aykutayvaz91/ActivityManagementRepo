@{
    ViewData["Title"] = "Faaliyet Tipleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var types = ViewBag.Types as System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>
                ?? new System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Admin">Admin Panel</a></li>
            <li class="breadcrumb-item active">Faaliyet Tipleri</li>
        </ol>
    </nav>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white"><h6 class="mb-0" id="formTitle"><i class="fas fa-plus me-2"></i>Yeni Faaliyet Tipi</h6></div>
            <div class="card-body">
                <form asp-action="SaveActivityType" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="t_id" value="0" />
                    <div class="mb-2">
                        <label class="form-label small">Ad <span class="text-danger">*</span></label>
                        <input name="Name" id="t_name" class="form-control" required placeholder="örn. Toplantı" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Sıra</label>
                        <input name="SortOrder" id="t_sort" type="number" class="form-control" value="0" />
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" name="IsActive" value="true" id="t_active" class="form-check-input" checked />
                        <label class="form-check-label" for="t_active">Aktif</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-save me-1"></i>Kaydet</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">Temizle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent"><h6 class="mb-0"><i class="fas fa-tags me-2 text-primary"></i>Faaliyet Tipleri (@types.Count)</h6></div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Ad</th><th class="text-center">Sıra</th><th class="text-center">Aktif</th><th></th></tr></thead>
                    <tbody>
                        @if (!types.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Henüz faaliyet tipi yok.</td></tr>
                        }
                        @foreach (var t in types)
                        {
                            <tr>
                                <td><strong>@t.Name</strong></td>
                                <td class="text-center">@t.SortOrder</td>
                                <td class="text-center">@(t.IsActive ? "✓" : "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning py-0" onclick='editType(@Html.Raw(ActivityManagement.Web.Utils.JsonHelper.ToCamelCaseJson(t)))'><i class="fas fa-edit"></i></button>
                                    <form asp-action="DeleteActivityType" method="post" class="d-inline" onsubmit="return confirm('Silinsin mi?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function editType(t) {
    document.getElementById('formTitle').innerText = 'Faaliyet Tipi Düzenle: ' + t.name;
    document.getElementById('t_id').value = t.id;
    document.getElementById('t_name').value = t.name;
    document.getElementById('t_sort').value = t.sortOrder;
    document.getElementById('t_active').checked = t.isActive;
    window.scrollTo(0, 0);
}
function resetForm() {
    document.getElementById('formTitle').innerText = 'Yeni Faaliyet Tipi';
    document.getElementById('t_id').value = 0;
    document.getElementById('t_name').value = '';
    document.getElementById('t_sort').value = 0;
    document.getElementById('t_active').checked = true;
}
</script>
}

@model ActivityManagement.Reports.Dto.PersonalReportDto
@{
    ViewData["Title"] = $"{Model.EmployeeName} - Faaliyet Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Reports/Personal">Kişisel Rapor</a></li>
            <li class="breadcrumb-item active">@Model.EmployeeName</li>
        </ol>
    </nav>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-print me-1"></i>Yazdır
        </button>
        <button onclick="exportReport()" class="btn btn-success btn-sm">
            <i class="fas fa-file-excel me-1"></i>Excel
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SummaryText))
{
    <div class="alert alert-info d-flex align-items-center">
        <i class="fas fa-quote-left me-2"></i><span>@Model.SummaryText</span>
    </div>
}

@if (Model.CombinedTypeBreakdown.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-transparent">
            <h6 class="mb-0"><i class="fas fa-layer-group me-2 text-primary"></i>Tip Bazlı Dağılım (Görev + Faaliyet)</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tip</th>
                        <th class="text-center">Görev</th>
                        <th class="text-center">Faaliyet</th>
                        <th class="text-center">Toplam Saat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.CombinedTypeBreakdown)
                    {
                        <tr>
                            <td><strong>@b.Type</strong></td>
                            <td class="text-center">@(b.TaskCount > 0 ? $"{b.TaskCount} adet" : "-")</td>
                            <td class="text-center">@(b.ActivityCount > 0 ? $"{b.ActivityCount} adet" : "-")</td>
                            <td class="text-center"><span class="badge bg-secondary">@((b.TaskHours + b.ActivityHours).ToString("0.##")) s</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-transparent small text-muted">
            Örn: "3 Bakım görevi + 5 Bakım faaliyeti". Görevler seçilen aralıkta <strong>tamamlanan</strong> görevlerdir; faaliyetler efor kayıtlarıdır.
        </div>
    </div>
}

<!-- Özet Kartlar -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-2x mb-2"></i>
                <div class="h3 mb-0">@Model.TotalHours.ToString("F1")</div>
                <small>Toplam Saat</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <i class="fas fa-list fa-2x mb-2"></i>
                <div class="h3 mb-0">@Model.TotalActivities</div>
                <small>Faaliyet Sayısı</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <i class="fas fa-check-circle fa-2x mb-2"></i>
                <div class="h3 mb-0">@Model.CompletedTaskCount</div>
                <small>Tamamlanan Görev</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <i class="fas fa-hourglass-half fa-2x mb-2"></i>
                <div class="h3 mb-0">@Model.PendingTaskCount</div>
                <small>Bekleyen Görev</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Personel Bilgisi -->
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="fas fa-user me-2 text-primary"></i>Personel Bilgisi</h6>
            </div>
            <div class="card-body small">
                <table class="table table-borderless table-sm mb-0">
                    <tr><td class="text-muted">Ad Soyad:</td><td><strong>@Model.EmployeeName</strong></td></tr>
                    <tr><td class="text-muted">Unvan:</td><td>@Model.Title</td></tr>
                    <tr><td class="text-muted">Departman:</td><td>@Model.Department</td></tr>
                    <tr><td class="text-muted">Dönem:</td><td>@Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</td></tr>
                </table>
            </div>
        </div>

        <!-- İş Tipi Kırılımı -->
        @if (Model.TaskTypeBreakdown.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-layer-group me-2 text-primary"></i>İş Tipi Dağılımı (Tamamlanan)</h6>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var b in Model.TaskTypeBreakdown)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center small">
                            <span>@b.Type</span>
                            <span><span class="badge bg-secondary me-1">@b.Count adet</span><span class="badge bg-primary">@b.Hours.ToString("0.##") s</span></span>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Faaliyet Tipi Kırılımı (efor) -->
        @if (Model.ActivityTypeBreakdown.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-clipboard-check me-2 text-success"></i>Faaliyet Tipi Dağılımı (Efor)</h6>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var b in Model.ActivityTypeBreakdown)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center small">
                            <span>@b.Type</span>
                            <span><span class="badge bg-secondary me-1">@b.Count kayıt</span><span class="badge bg-success">@b.Hours.ToString("0.##") s</span></span>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Proje Özeti -->
        @if (Model.ProjectSummaries.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-project-diagram me-2 text-info"></i>Proje Dağılımı</h6>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.ProjectSummaries.OrderByDescending(x => x.TotalHours))
                    {
                        <li class="list-group-item small">
                            <div class="d-flex justify-content-between">
                                <span><strong>@p.ProjectName</strong></span>
                                <span class="badge bg-primary">@p.TotalHours.ToString("F1") s</span>
                            </div>
                            <small class="text-muted">@p.CompletedTaskCount / @p.TaskCount görev tamamlandı</small>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <!-- Günlük Faaliyetler -->
    <div class="col-md-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="fas fa-calendar-check me-2 text-success"></i>Günlük Faaliyet Özeti</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Gün</th>
                            <th>Faaliyet</th>
                            <th>Süre</th>
                            <th>Açıklamalar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DailyActivities.OrderByDescending(d => d.Date))
                        {
                            <tr>
                                <td><strong>@day.Date.ToString("dd.MM.yyyy")</strong></td>
                                <td><small class="text-muted">@day.Date.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"))</small></td>
                                <td><span class="badge bg-light text-dark">@day.ActivityCount</span></td>
                                <td><span class="badge bg-primary">@day.Hours.ToString("F1") s</span></td>
                                <td>
                                    <small class="text-muted">
                                        @string.Join("; ", day.Descriptions.Take(2))
                                        @if (day.Descriptions.Count > 2) { <span>+@(day.Descriptions.Count - 2) daha</span> }
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr>
                            <td colspan="3"><strong>Toplam</strong></td>
                            <td><strong>@Model.TotalHours.ToString("F1") s</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- V4: Ne Yaptı? — adım adım detaylı faaliyet kayıtları -->
        @if (Model.DetailedActivities.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-list-ol me-2 text-info"></i>Ne Yaptı? — Detaylı Faaliyet Kayıtları</h6>
                    <span class="badge bg-secondary">@Model.DetailedActivities.Count kayıt</span>
                </div>
                <div class="table-responsive" style="max-height:420px;overflow-y:auto">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light" style="position:sticky;top:0">
                            <tr>
                                <th>Tarih</th>
                                <th>Alt Başlık</th>
                                <th>Tip</th>
                                <th>Detay Not</th>
                                <th class="text-center">Süre</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.DetailedActivities)
                            {
                                <tr>
                                    <td class="small text-nowrap">@d.Date.ToString("dd.MM.yyyy")</td>
                                    <td class="small fw-semibold">@d.SubHeading</td>
                                    <td class="small"><span class="badge bg-light text-dark">@d.ActivityType</span></td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(d.Detail) ? "-" : d.Detail)</td>
                                    <td class="text-center small">@d.Hours.ToString("0.##") s</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Görevler -->
        @if (Model.TaskSummaries.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0"><i class="fas fa-tasks me-2 text-warning"></i>Görev Durumu</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Görev</th><th>Durum</th><th>Öncelik</th><th>Son Tarih</th><th>%</th><th>Süre</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TaskSummaries)
                            {
                                <tr>
                                    <td><small>@t.Title</small></td>
                                    <td><span class="badge bg-secondary" style="font-size:0.7rem">@t.Status</span></td>
                                    <td><span class="badge bg-light text-dark" style="font-size:0.7rem">@t.Priority</span></td>
                                    <td><small>@(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd.MM") : "-")</small></td>
                                    <td>
                                        <div class="progress" style="width:50px;height:5px">
                                            <div class="progress-bar" style="width:@t.CompletionPercentage%"></div>
                                        </div>
                                    </td>
                                    <td><small>@t.ActualHours s</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function exportReport() {
    var url = '/Reports/ExportPersonalExcel?employeeId=@Model.EmployeeId'
        + '&startDate=@Model.StartDate.ToString("yyyy-MM-dd")'
        + '&endDate=@Model.EndDate.ToString("yyyy-MM-dd")';
    window.location.href = url;
}
</script>
}

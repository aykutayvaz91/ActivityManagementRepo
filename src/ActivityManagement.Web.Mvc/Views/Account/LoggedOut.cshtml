@{
    Layout = null;
    var logo = ViewData["ThemeLogo"] as string;
    var brand = ViewData["ThemeBrand"] as string;
    if (string.IsNullOrWhiteSpace(brand)) brand = "Faaliyet Yönetim Sistemi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Çıkış Yapıldı - @brand</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%); min-height: 100vh; display: flex; align-items: center; }
        .login-card { max-width: 420px; width: 100%; border: none; border-radius: 1rem; }
        .brand-icon { width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg,#0d6efd,#6610f2); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin:0 auto 1rem; }
    </style>
</head>
<body>
    <div class="container">
        <div class="d-flex justify-content-center">
            <div class="card shadow-lg login-card">
                <div class="card-body p-4 p-md-5 text-center">
                    @if (!string.IsNullOrEmpty(logo))
                    {
                        <img src="@logo" alt="logo" style="max-height:72px;max-width:100%" class="d-block mx-auto mb-3" />
                    }
                    else
                    {
                        <div class="brand-icon"><i class="fas fa-sign-out-alt"></i></div>
                    }
                    <h4 class="mb-1">Çıkış yapıldı</h4>
                    <p class="text-muted small mb-4">Oturumunuz güvenle sonlandırıldı.</p>

                    <a href="/Account/Login" class="btn btn-primary w-100 py-2">
                        <i class="fas fa-right-to-bracket me-1"></i>Tekrar Giriş Yap
                    </a>

                    <p class="text-center text-muted mt-4 mb-0" style="font-size:.72rem" title="Yazılım sürümü">v@(ActivityManagement.ActivityManagementConsts.AppVersion)</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

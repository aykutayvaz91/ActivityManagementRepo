@{
    // Tema base controller tarafından ViewData'ya yazılır (V4).
    var __primary = ViewData["ThemePrimary"] as string;
    if (string.IsNullOrWhiteSpace(__primary)) __primary = "#0d6efd";
    var __logo = ViewData["ThemeLogo"] as string;
    var __brand = ViewData["ThemeBrand"] as string;
    if (string.IsNullOrWhiteSpace(__brand)) __brand = "Faaliyet Yönetimi";

    // Rol × Sayfa erişimi (base controller ViewData'ya koyar). Admin veya set yoksa: izinli (fail-open).
    var __allowed = ViewData["AllowedPages"] as System.Collections.Generic.HashSet<string>;
    bool __isAdmin = User?.IsInRole("Admin") == true;
    // Kişiye bağlı mı (normal kullanıcı VEYA login-as ile bir kişi olarak işlem yapan admin)?
    var __empIdClaim = User?.FindFirst("EmployeeId")?.Value;
    var __ownIdClaim = User?.FindFirst("AdminOwnEmployeeId")?.Value;
    bool __hasEmp = !string.IsNullOrEmpty(__empIdClaim);
    // Admin, login-as ile KENDİ (Sistem Yöneticisi) dışında birine geçmiş mi?
    bool __actingAsOther = __isAdmin && __hasEmp && !string.IsNullOrEmpty(__ownIdClaim) && __empIdClaim != __ownIdClaim;
    System.Func<string, bool> Can = key => __isAdmin || __allowed == null || __allowed.Contains(key);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @__brand</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        /* V4: Admin tarafından seçilen dinamik ana renk */
        :root { --app-primary: @__primary; }
        .bg-primary { background-color: var(--app-primary) !important; }
        .btn-primary { background-color: var(--app-primary) !important; border-color: var(--app-primary) !important; }
        .btn-outline-primary { color: var(--app-primary) !important; border-color: var(--app-primary) !important; }
        .btn-outline-primary:hover { background-color: var(--app-primary) !important; color: #fff !important; }
        .text-primary { color: var(--app-primary) !important; }
        .nav-tabs .nav-link.active { color: var(--app-primary) !important; }
        .progress-bar { background-color: var(--app-primary); }
        a { color: var(--app-primary); }
        /* Sticky footer: içerik kısa olsa bile footer en altta sabit kalır, uzun olunca alta iter */
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .am-content { flex: 1 0 auto; }
        /* Footer navbar ile aynı temaya (ana renk) bağlı */
        .footer { flex-shrink: 0; background-color: var(--app-primary) !important; }
        .footer, .footer small { color: rgba(255,255,255,.9) !important; }
        /* Menü katmanlaşması: dropdown'lar içerik/kartların üstünde kalsın (çakışma önlemi) */
        .navbar { z-index: 1030; }
        .navbar .dropdown-menu { z-index: 1056; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-xl navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
                @if (!string.IsNullOrEmpty(__logo))
                {
                    <img src="@__logo" alt="logo" style="max-height:36px;margin-right:8px;background:transparent" />
                }
                else
                {
                    <i class="fas fa-tasks me-2"></i>
                }
                <span>@__brand</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @* İŞLERİM hub: Genel Bakış + Görevlerim/Görevler + Pano + Faaliyetler + Görev Sorgula *@
                    @{
                        bool __canWorkHub = Can("Work") || Can("MyTasks") || Can("Board") || Can("Activities")
                            || (__isAdmin && Can("Tasks")) || Can("TaskQuery");
                    }
                    @if (__canWorkHub)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="workMenu" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-briefcase me-1"></i>İşlerim
                            </a>
                            <ul class="dropdown-menu">
                                @if (Can("Work"))
                                {
                                    <li><a class="dropdown-item" href="/Work"><i class="fas fa-list-check me-2"></i>Genel Bakış</a></li>
                                }
                                @* Sistem Yöneticisi (admin kendi kimliği) → "Görevler" (kategoriler). Login-as/normal → "Görevlerim". *@
                                @if (((!__isAdmin && __hasEmp) || __actingAsOther) && Can("MyTasks"))
                                {
                                    <li><a class="dropdown-item" href="/Tasks/MyTasks"><i class="fas fa-user-check me-2"></i>Görevlerim</a></li>
                                }
                                @if (__isAdmin && !__actingAsOther && Can("Tasks"))
                                {
                                    <li><a class="dropdown-item" href="/Tasks"><i class="fas fa-clipboard-list me-2"></i>Görevler</a></li>
                                }
                                @if (Can("Board"))
                                {
                                    <li><a class="dropdown-item" href="/Tasks/Board"><i class="fas fa-columns me-2"></i>Pano</a></li>
                                }
                                @if (Can("Activities"))
                                {
                                    <li><a class="dropdown-item" href="/Activities"><i class="fas fa-clipboard-check me-2"></i>Faaliyetler</a></li>
                                }
                                @if (Can("TaskQuery"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Tasks/Completed"><i class="fas fa-magnifying-glass me-2"></i>Görev Sorgula</a></li>
                                }
                            </ul>
                        </li>
                    }
                    @* TALEPLER: Sunucu (psm.tdv.org) + Destek (destek.cmit.com.tr) *@
                    @if (Can("Requests"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="reqMenu" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-inbox me-1"></i>Talepler
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Requests"><i class="fas fa-layer-group me-2"></i>Tüm Talepler</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/Requests#tab-sunucu"><i class="fas fa-server me-2"></i>Sunucu Talepleri</a></li>
                                <li><a class="dropdown-item" href="/Requests#tab-destek"><i class="fas fa-headset me-2"></i>Destek Talepleri</a></li>
                            </ul>
                        </li>
                    }
                    @if (Can("DailyEffort"))
                    {
                        <li class="nav-item"><a class="nav-link" href="/Activities/Today"><i class="fas fa-business-time me-1"></i>Günlük Efor</a></li>
                    }
                    @if (Can("Projects"))
                    {
                        <li class="nav-item"><a class="nav-link" href="/Projects"><i class="fas fa-project-diagram me-1"></i>Projeler</a></li>
                    }
                    @if (Can("Employees"))
                    {
                        <li class="nav-item"><a class="nav-link" href="/Employees"><i class="fas fa-users me-1"></i>Personeller</a></li>
                    }
                    @if (Can("Reports"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="reportsMenu" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-chart-bar me-1"></i>Raporlar
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Reports/Personal"><i class="fas fa-user me-2"></i>Kişisel Rapor</a></li>
                                <li><a class="dropdown-item" href="/Reports/Team"><i class="fas fa-users me-2"></i>Ekip Raporu</a></li>
                            </ul>
                        </li>
                    }
                    @if (Can("Admin") && (User?.IsInRole("Admin") == true || User?.IsInRole("TakımLideri") == true))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" href="/Admin"><i class="fas fa-user-shield me-1"></i>Admin Panel</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (__hasEmp)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link position-relative" href="#" id="notifBell" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Bildirimler">
                                <i class="fas fa-bell"></i>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="width:340px;max-height:460px;overflow:auto">
                                <li class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-bell me-1"></i>Bildirimler</span>
                                    <a href="#" class="small text-decoration-none" onclick="markAllNotifRead();return false;">Tümünü okundu</a>
                                </li>
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li id="notifEmpty" class="text-center text-muted small py-3">Bildirim yok</li>
                                <li><div id="notifList"></div></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" id="msgBtn" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Üst yönetime istek/mesaj gönder">
                                <i class="fas fa-paper-plane"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow p-3" style="width:330px">
                                <li><h6 class="mb-2"><i class="fas fa-paper-plane me-1"></i>Üst Yönetime İstek / Mesaj</h6></li>
                                <li>
                                    <label class="form-label small mb-1">Kime</label>
                                    <select id="msgTo" class="form-select form-select-sm mb-2"><option value="">Yükleniyor…</option></select>
                                    <label class="form-label small mb-1">Mesaj / İstek</label>
                                    <textarea id="msgText" class="form-control form-control-sm mb-2" rows="3" placeholder="İhtiyacınızı / isteğinizi yazın; üst yöneticinizin bildirimlerine düşer."></textarea>
                                    <button type="button" class="btn btn-primary btn-sm w-100" onclick="sendUpMessage()"><i class="fas fa-paper-plane me-1"></i>Gönder</button>
                                </li>
                            </ul>
                        </li>
                    }
                    @if (__isAdmin)
                    {
                        var actingName = User.FindFirst("ActingAsName")?.Value;
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin" title="Kişi olarak işlem yap (değiştir)">
                                <span class="badge bg-warning text-dark"><i class="fas fa-user-secret me-1"></i>@(string.IsNullOrEmpty(actingName) ? "kişi seç" : actingName) olarak</span>
                            </a>
                        </li>
                    }
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@(User.Identity.Name)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Logout"><i class="fas fa-sign-out-alt me-2"></i>Çıkış Yap</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login"><i class="fab fa-google me-1"></i>Giriş Yap</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-3 am-content">
        @RenderBody()
    </div>

    <footer class="footer py-3 mt-4">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-1">
                <small class="opacity-75 flex-fill text-md-start text-center"><i class="fas fa-code me-1"></i>Designed by <strong>Aykut AYVAZ</strong></small>
                <small class="flex-fill text-center">&copy; @DateTime.Now.Year Faaliyet Yönetim Sistemi · CMIT Bilişim Arge A.Ş.</small>
                <small class="opacity-75 flex-fill text-md-end text-center" title="Yazılım sürümü">v@(ActivityManagement.ActivityManagementConsts.AppVersion)</small>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales-all.global.min.js"></script>
    @{
        var amRole = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        var amEmpId = User?.FindFirst("EmployeeId")?.Value ?? "null";
        var amIsManager = (User?.IsInRole("Admin") == true || User?.IsInRole("TakımLideri") == true) ? "true" : "false";
    }
    <script>
        window.AM = { role: '@amRole', empId: @amEmpId, isManager: @amIsManager };
    </script>
    <script src="~/js/site.js"></script>

    @* ===== In-app bildirim (polling + toast + ses) ===== *@
    @if (__hasEmp)
    {
        <span id="notifAf" style="display:none">@Html.AntiForgeryToken()</span>
        <script>
        (function () {
            var lastMaxId = 0, audioCtx = null, soundOn = true, started = false;
            function afToken() { return document.querySelector('#notifAf input[name="__RequestVerificationToken"]').value; }
            // Ses: ilk kullanıcı etkileşiminden sonra AudioContext açılır (autoplay politikası)
            document.addEventListener('click', function initAudio() {
                try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {}
            }, { once: true });
            function ding() {
                if (!soundOn || !audioCtx) return;
                try {
                    var o = audioCtx.createOscillator(), g = audioCtx.createGain();
                    o.type = 'sine'; o.frequency.value = 880; g.gain.value = 0.05;
                    o.connect(g); g.connect(audioCtx.destination);
                    var t = audioCtx.currentTime;
                    o.start(); o.frequency.setValueAtTime(660, t + 0.12);
                    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.32); o.stop(t + 0.33);
                } catch (e) {}
            }
            function esc(s) { return (s || '').replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
            function render(data) {
                var badge = document.getElementById('notifBadge');
                var n = data.unreadCount || 0;
                if (badge) { badge.textContent = n > 99 ? '99+' : n; badge.style.display = n > 0 ? '' : 'none'; }
                var list = document.getElementById('notifList'), empty = document.getElementById('notifEmpty');
                var items = data.recent || [];
                if (!items.length) { if (empty) empty.style.display = ''; if (list) list.innerHTML = ''; return; }
                if (empty) empty.style.display = 'none';
                var html = '';
                items.forEach(function (x) {
                    var bg = x.isRead ? '' : 'background:rgba(13,110,253,.06);';
                    html += '<a href="#" onclick="notifClick(' + x.id + ',' + JSON.stringify(x.link || '') + ');return false;" ' +
                        'class="dropdown-item d-flex gap-2 py-2 border-bottom" style="white-space:normal;' + bg + '">' +
                        '<span class="text-' + (x.severity || 'info') + '"><i class="fas ' + (x.icon || 'fa-bell') + '"></i></span>' +
                        '<span class="flex-fill"><span class="fw-semibold small">' + esc(x.title) + '</span>' +
                        '<span class="d-block text-muted small">' + esc(x.message) + '</span>' +
                        '<span class="d-block text-muted" style="font-size:.7rem">' + esc(x.timeAgo) + '</span></span>' +
                        (x.isRead ? '' : '<span class="badge bg-primary align-self-start" style="width:8px;height:8px;padding:0;border-radius:50%"></span>') +
                        '</a>';
                });
                if (list) list.innerHTML = html;
            }
            function load(showToast) {
                fetch('/Notifications/Summary', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) return;
                        if (data.__abp && data.result !== undefined) data = data.result; // ABP zarfını aç
                        if (!data) return;
                        render(data);
                        var items = data.recent || [];
                        if (showToast && started) {
                            var fresh = items.filter(function (x) { return x.id > lastMaxId && !x.isRead; });
                            if (fresh.length) {
                                ding();
                                fresh.slice(0, 3).forEach(function (x) {
                                    if (window.abp && abp.notify) abp.notify.info(esc(x.message || x.title), esc(x.title));
                                });
                            }
                        }
                        if (items.length && items[0].id > lastMaxId) lastMaxId = items[0].id;
                        started = true;
                    }).catch(function () {});
            }
            window.notifClick = function (id, link) {
                fetch('/Notifications/MarkRead', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': afToken() },
                    body: 'id=' + id + '&__RequestVerificationToken=' + encodeURIComponent(afToken())
                }).then(function () { if (link) window.location = link; else load(false); });
            };
            window.markAllNotifRead = function () {
                fetch('/Notifications/MarkAllRead', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': afToken() },
                    body: '__RequestVerificationToken=' + encodeURIComponent(afToken())
                }).then(function () { load(false); });
            };
            // --- Üst yönetime istek/mesaj ---
            var msgLoaded = false;
            function loadRecipients() {
                fetch('/Notifications/Recipients', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (data && data.__abp && data.result !== undefined) data = data.result;
                        var sel = document.getElementById('msgTo'); if (!sel) return;
                        if (!data || !data.length) { sel.innerHTML = '<option value="">Gönderebileceğiniz üst yönetici yok</option>'; return; }
                        sel.innerHTML = data.map(function (x) { return '<option value="' + x.id + '">' + esc(x.name) + ' — ' + esc(x.roleLabel) + '</option>'; }).join('');
                    }).catch(function () {});
            }
            window.sendUpMessage = function () {
                var to = document.getElementById('msgTo').value;
                var txt = (document.getElementById('msgText').value || '').trim();
                if (!to) { if (window.abp) abp.notify.warn('Alıcı seçin.'); return; }
                if (!txt) { if (window.abp) abp.notify.warn('Mesaj yazın.'); return; }
                fetch('/Notifications/SendMessage', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': afToken() },
                    body: 'recipientEmployeeId=' + encodeURIComponent(to) + '&message=' + encodeURIComponent(txt) + '&__RequestVerificationToken=' + encodeURIComponent(afToken())
                }).then(function (r) {
                    if (r.ok) {
                        if (window.abp) abp.notify.success('İsteğiniz iletildi.');
                        document.getElementById('msgText').value = '';
                        var dd = bootstrap.Dropdown.getInstance(document.getElementById('msgBtn')); if (dd) dd.hide();
                    } else { r.text().then(function (t) { if (window.abp) abp.notify.error(t || 'Gönderilemedi.'); }); }
                }).catch(function () { if (window.abp) abp.notify.error('Gönderilemedi.'); });
            };
            var msgBtn = document.getElementById('msgBtn');
            if (msgBtn) msgBtn.addEventListener('click', function () { if (!msgLoaded) { msgLoaded = true; loadRecipients(); } });

            document.addEventListener('DOMContentLoaded', function () {
                load(false);
                setInterval(function () { load(true); }, 25000);
            });
        })();
        </script>
    }

    @if (TempData["Success"] != null || TempData["Error"] != null || TempData["Uyari"] != null)
    {
        <script>
            (function () {
                function t(m, type) { if (window.abp && abp.notify) abp.notify[type](m); }
                @if (TempData["Success"] != null) { <text>t(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Success"].ToString())), 'success');</text> }
                @if (TempData["Error"] != null) { <text>t(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Error"].ToString())), 'error');</text> }
                @if (TempData["Uyari"] != null) { <text>t(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["Uyari"].ToString())), 'warn');</text> }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

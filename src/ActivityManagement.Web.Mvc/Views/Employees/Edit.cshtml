@model ActivityManagement.Employees.Dto.CreateUpdateEmployeeDto
@{
    ViewData["Title"] = "Personel Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isManager = User.IsInRole("Admin") || User.IsInRole("TakımLideri");
    var teams = ViewBag.Teams as System.Collections.Generic.List<ActivityManagement.Teams.Dto.TeamDto>
                ?? new System.Collections.Generic.List<ActivityManagement.Teams.Dto.TeamDto>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Employees">Personeller</a></li>
            <li class="breadcrumb-item active">Düzenle</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-user-edit me-2"></i>Personel Düzenle</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Ad <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Soyad <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Title" class="form-label">Unvan</label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Birim <small class="text-muted">(görev grubu)</small></label>
                            <select asp-for="Department" class="form-select">
                                <option value="">Seçiniz...</option>
                                <option value="Sistem Birimi">Sistem Birimi</option>
                                <option value="Network Birimi">Network Birimi</option>
                            </select>
                        </div>
                        @if (isManager)
                        {
                            <div class="col-md-6">
                                <label asp-for="AppRole" class="form-label">Rol</label>
                                <select asp-for="AppRole" class="form-select">
                                    <option value="Uzman">Uzman</option>
                                    <option value="TakımLideri">Takım Lideri</option>
                                    <option value="Manager">Manager (Tüm Takımlar)</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="teamField">
                                <label asp-for="TeamId" class="form-label">Takım</label>
                                <select asp-for="TeamId" class="form-select">
                                    <option value="">— Takımsız —</option>
                                    @foreach (var t in teams)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                                <span class="text-muted small" id="teamManagerNote" style="display:none">Manager tüm takımları görür — takıma bağlanmaz.</span>
                            </div>
                        }
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">E-posta</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Telefon</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HireDate" class="form-label">İşe Başlama Tarihi</label>
                            <input asp-for="HireDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BirthDate" class="form-label">Doğum Tarihi</label>
                            <input asp-for="BirthDate" class="form-control" type="date" />
                        </div>
                        <div class="col-12">
                            <label asp-for="ExpertiseAreas" class="form-label">Uzmanlık Alanları</label>
                            <input asp-for="ExpertiseAreas" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Profil Fotoğrafı</label>
                            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                            {
                                <div class="mb-1"><img src="@Model.PhotoUrl" style="height:48px;width:48px;object-fit:cover;border-radius:50%" /></div>
                            }
                            <input type="file" name="photoFile" accept="image/*" class="form-control" />
                            <input asp-for="PhotoUrl" type="hidden" />
                            <small class="text-muted">Yeni fotoğraf yüklemezseniz mevcut korunur.</small>
                        </div>
                        @if (isManager)
                        {
                            <div class="col-md-6">
                                <label class="form-label d-block">Durum</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label">Aktif</label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsOnLeave" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsOnLeave" class="form-check-label">İzinli <small class="text-muted">(görev atamada uyarı verilir)</small></label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="LeaveStartDate" class="form-label">İzin Başlangıç <small class="text-muted">(ops.)</small></label>
                                <input asp-for="LeaveStartDate" class="form-control" type="date" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="LeaveEndDate" class="form-label">İzin Bitiş <small class="text-muted">(ops.)</small></label>
                                <input asp-for="LeaveEndDate" class="form-control" type="date" />
                            </div>
                        }
                        else
                        {
                            <input asp-for="AppRole" type="hidden" />
                            <input asp-for="IsActive" type="hidden" />
                            <input asp-for="IsOnLeave" type="hidden" />
                            <input asp-for="LeaveStartDate" type="hidden" />
                            <input asp-for="LeaveEndDate" type="hidden" />
                            <input asp-for="TeamId" type="hidden" />
                        }
                    </div>

                    <hr />
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="/Employees" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-1"></i>Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var role = document.getElementById('AppRole');
            var team = document.getElementById('TeamId');
            var note = document.getElementById('teamManagerNote');
            function sync() {
                var isMgr = role && role.value === 'Manager';
                if (team) { team.disabled = isMgr; if (isMgr) team.value = ''; }
                if (note) note.style.display = isMgr ? '' : 'none';
            }
            if (role) { role.addEventListener('change', sync); sync(); }
        })();
    </script>
}

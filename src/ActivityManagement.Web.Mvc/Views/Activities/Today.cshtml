@{
    ViewData["Title"] = "Günlük Efor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var day = (DateTime)ViewBag.Day;
    var de = ViewBag.DayEffort as ActivityManagement.Activities.Dto.DayEffortDto ?? new ActivityManagement.Activities.Dto.DayEffortDto { Date = day };
    var types = ViewBag.ActivityTypes as System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>
                ?? new System.Collections.Generic.List<ActivityManagement.Activities.Dto.ActivityTypeDefDto>();
    var projects = ViewBag.Projects as System.Collections.Generic.IList<ActivityManagement.Projects.Dto.ProjectDto>
                   ?? new System.Collections.Generic.List<ActivityManagement.Projects.Dto.ProjectDto>();
    var dayTasks = ViewBag.DayTasks as System.Collections.Generic.List<ActivityManagement.Tasks.Dto.TaskItemDto>
                   ?? new System.Collections.Generic.List<ActivityManagement.Tasks.Dto.TaskItemDto>();
    var dstr = day.ToString("yyyy-MM-dd");
    bool complete = de.MissingHours <= 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-business-time text-primary me-2"></i>Günlük Efor</h2>
    <form method="get" asp-action="Today" class="d-flex align-items-center gap-2">
        <label class="small text-muted mb-0">Gün:</label>
        <input type="date" name="date" value="@dstr" class="form-control form-control-sm" style="max-width:170px" onchange="this.form.submit()" />
    </form>
</div>

<!-- Efor durumu / uyarı -->
<div class="card shadow-sm mb-3 border-@(complete ? "success" : "warning")">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="text-muted">@day.ToString("dd.MM.yyyy dddd", new System.Globalization.CultureInfo("tr-TR"))</span>
            <div class="mt-1">
                <span class="badge bg-primary fs-6">@de.TotalHours.ToString("0.##") s girildi</span>
                <span class="badge bg-secondary fs-6">Hedef 8 s</span>
                @if (complete)
                {
                    <span class="badge bg-success fs-6"><i class="fas fa-check me-1"></i>Tamam</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6"><i class="fas fa-exclamation-triangle me-1"></i>@de.MissingHours.ToString("0.##") saat eksik efor</span>
                }
            </div>
        </div>
        @if (!complete)
        {
            <form asp-action="CompleteDayTo8Hours" method="post"
                  onsubmit="return confirm('Eksik @de.MissingHours.ToString("0.##") saat, 1. sorumlu olduğunuz sistemlerden 1&#39;er saatlik rutin kontrol eforu ile tamamlanacak. Onaylıyor musunuz?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@dstr" />
                <button type="submit" class="btn btn-success"><i class="fas fa-clock me-1"></i>Efor 8 Saat Tamamla</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <!-- Efor kayıtları -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent"><h6 class="mb-0"><i class="fas fa-clock me-2 text-primary"></i>Efor Kayıtları (@de.Efforts.Count)</h6></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Tip</th><th>Konu / Görev</th><th>Açıklama</th><th class="text-center">Süre</th><th></th></tr></thead>
                    <tbody>
                        @if (!de.Efforts.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Bu gün için efor kaydı yok.</td></tr>
                        }
                        @foreach (var e in de.Efforts)
                        {
                            string subj;
                            if (!string.IsNullOrEmpty(e.ActivitySubjectTitle)) subj = "Konu: " + e.ActivitySubjectTitle;
                            else if (!string.IsNullOrEmpty(e.TaskTitle)) subj = "Görev: " + e.TaskTitle;
                            else if (!string.IsNullOrEmpty(e.ProjectName)) subj = "Proje: " + e.ProjectName;
                            else subj = "-";
                            <tr>
                                <td class="small"><span class="badge bg-light text-dark">@(string.IsNullOrEmpty(e.ActivityType) ? "-" : e.ActivityType)</span></td>
                                <td class="small">@subj</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(e.Description) ? "-" : e.Description)</td>
                                <td class="text-center small fw-semibold">@e.HoursSpent.ToString("0.##") s</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-warning py-0"
                                            onclick='editEffort(@e.Id, "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(e.Description ?? ""))", @e.HoursSpent.ToString(System.Globalization.CultureInfo.InvariantCulture), "@e.ActivityType", "@(e.ProjectId?.ToString() ?? "")")'>
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="DeleteDayEffort" method="post" class="d-inline" onsubmit="return confirm('Silinsin mi?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <input type="hidden" name="date" value="@dstr" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary">
                        <tr><td colspan="3" class="text-end"><strong>Toplam</strong></td><td class="text-center"><strong>@de.TotalHours.ToString("0.##") s</strong></td><td></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- O güne ait görevler -->
        <div class="card shadow-sm mt-3">
            <div class="card-header bg-transparent"><h6 class="mb-0"><i class="fas fa-tasks me-2 text-warning"></i>Bu Güne Ait Görevlerim (@dayTasks.Count)</h6></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Görev</th><th>Durum</th><th>Başlangıç</th><th>Son Tarih</th></tr></thead>
                    <tbody>
                        @if (!dayTasks.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Bu güne ait görev yok.</td></tr>
                        }
                        @foreach (var t in dayTasks)
                        {
                            <tr>
                                <td class="small"><a href="/Tasks/Detail/@t.Id">@t.Title</a></td>
                                <td class="small">@t.StatusText</td>
                                <td class="small text-muted">@(t.StartDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                <td class="small text-muted">@(t.DueDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Efor ekle / düzenle -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white"><h6 class="mb-0" id="effortFormTitle"><i class="fas fa-plus me-2"></i>Efor Ekle</h6></div>
            <div class="card-body">
                <form id="effortForm" asp-action="AddDayEffort" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" id="ef_date" value="@dstr" />
                    <input type="hidden" name="activityDate" id="ef_activityDate" value="@dstr" />
                    <input type="hidden" name="id" id="ef_id" value="0" />
                    <div class="mb-2">
                        <label class="form-label small">Proje <small class="text-muted">(opsiyonel)</small></label>
                        <select name="projectId" id="ef_project" class="form-select form-select-sm">
                            <option value="">— Proje yok —</option>
                            @foreach (var p in projects)
                            {
                                <option value="@p.Id">[@p.Code] @p.Name</option>
                            }
                        </select>
                        <small class="text-muted">Seçilirse efor projeye sayılır.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Faaliyet Tipi</label>
                        <select name="activityType" id="ef_type" class="form-select form-select-sm">
                            @foreach (var t in types)
                            {
                                <option value="@t.Name">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Süre (saat)</label>
                        <input type="number" name="hoursSpent" id="ef_hours" class="form-control form-control-sm" step="0.25" min="0.25" value="1" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Açıklama</label>
                        <textarea name="description" id="ef_desc" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm flex-fill"><i class="fas fa-save me-1"></i>Kaydet</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetEffortForm()">Yeni</button>
                    </div>
                </form>
                <small class="text-muted d-block mt-2">Otomatik eklenen rutin kontrol eforlarını da buradan düzenleyebilirsiniz.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function editEffort(id, desc, hours, type, projectId) {
    document.getElementById('effortFormTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Efor Düzenle';
    document.getElementById('effortForm').setAttribute('action', '/Activities/UpdateDayEffort');
    document.getElementById('ef_id').value = id;
    document.getElementById('ef_desc').value = desc;
    document.getElementById('ef_hours').value = hours;
    if (type) document.getElementById('ef_type').value = type;
    document.getElementById('ef_project').value = projectId || '';
    window.scrollTo(0, document.body.scrollHeight);
}
function resetEffortForm() {
    document.getElementById('effortFormTitle').innerHTML = '<i class="fas fa-plus me-2"></i>Efor Ekle';
    document.getElementById('effortForm').setAttribute('action', '/Activities/AddDayEffort');
    document.getElementById('ef_id').value = 0;
    document.getElementById('ef_desc').value = '';
    document.getElementById('ef_hours').value = 1;
    document.getElementById('ef_project').value = '';
}
</script>
}
